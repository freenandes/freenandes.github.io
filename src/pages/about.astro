---
/** About & CV. Content comes from `src/content/cv.md`, edited by hand;
    everything about how it looks is in this file. */

import { getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import { marked } from 'marked';
import Base from '../layouts/Base.astro';
import PageNav from '../components/PageNav.astro';
import MiniMap from '../components/MiniMap.astro';
import Lightbox from '../components/Lightbox.astro';
import { site } from '../site.config';
import { withBase } from '../lib/base';
import { getProjects } from '../lib/projects';

const entry = await getEntry('cv', 'cv');
if (!entry) throw new Error('src/content/cv.md is missing — the About page renders from it.');
const cv = entry.data;

/** A thumbnail's height in CSS pixels, mirroring `--cv-thumb-height`, for the
    browser's guess at its width before layout. One that supports
    `sizes="auto"` measures the real width instead. */
const THUMB_HEIGHT_HINT = 72;
/** As in Gallery.astro: a WebP, JPEG or AVIF links to its file as it is, a
    PNG to a WebP of it; thumbnails are WebPs at this quality. */
const COMPRESSED = ['webp', 'jpg', 'jpeg', 'avif'];
const QUALITY = 90;

// A job with what sits under it on screen: its case studies, by title, and
// its thumbnails, each linking to its full image for the enlarged view. One
// that names a case study that isn't published fails the build, as the map does.
const projects = await getProjects();
type Extras = { org: string; caseStudies: string[]; images: { src: ImageMetadata; alt: string }[] };
const withExtras = async <Job extends Extras>({ caseStudies, images, ...job }: Job) => ({
  ...job,
  caseStudies: caseStudies.map((id) => {
    const project = projects.find((p) => p.id === id);
    if (!project) throw new Error(`cv.md: ${job.org} links to the case study "${id}", which isn't published.`);
    return { title: project.data.title, href: withBase(`/${id}/`) };
  }),
  images: await Promise.all(
    images.map(async ({ src, alt }) => {
      const url = COMPRESSED.includes(src.format)
        ? src.src
        : (await getImage({ src, format: 'webp', quality: QUALITY })).src;
      // Copies for 1×, 2× and 3× screens, none wider than the original.
      const shown = Math.ceil((THUMB_HEIGHT_HINT * src.width) / src.height);
      const widths = [1, 2, 3].map((n) => n * shown).filter((width) => width < src.width);
      const thumbs = widths.length
        ? await getImage({ src, width: widths[0], widths, format: 'webp', quality: QUALITY })
        : undefined;
      return {
        url,
        thumb: thumbs?.src ?? url,
        srcset: thumbs?.srcSet.attribute,
        sizes: `auto, ${shown}px`,
        alt,
        width: src.width,
        height: src.height,
      };
    })
  ),
});

// The jobs, then the earlier work, drawn alike: an earlier job is a job
// without bullets.
const jobSections = [
  { id: 'experience', title: 'Experience', step: 2, jobs: await Promise.all(cv.experience.map(withExtras)) },
  {
    id: 'earlier-work',
    title: 'Earlier work',
    step: undefined,
    jobs: await Promise.all(cv.earlierWork.map((job) => withExtras({ ...job, points: [] as string[] }))),
  },
];
const hasImages = jobSections.some((section) => section.jobs.some((job) => job.images.length > 0));
// The summary is a Markdown field (not the file body) so cv.md reads in page order.
const summary = await marked.parse(cv.summary);
const name = site.name;
// "https://www.linkedin.com/in/pmcfernandes" → "linkedin.com/in/pmcfernandes", for print.
const bareUrl = (href: string) => href.replace(/^https?:\/\/(www\.)?/, '');
// The printed contact line, in order: print-only extras, then the socials (the
// email as its token, for the script to spell out; the rest as bare addresses).
const printContacts = [
  ...site.printContacts.map((text) => ({ text, token: undefined })),
  ...site.socials.map((s) => ({ text: s.href && bareUrl(s.href), token: s.token })),
];
const headline = cv.headline;
// The small line under the name: "Leiria, Portugal / Fluent in Portuguese & English".
const { languages } = cv;
const fluentIn = languages.length
  ? `Fluent in ${[languages.slice(0, -1).join(', '), languages.at(-1)].filter(Boolean).join(' & ')}`
  : undefined;
const facts = [cv.location, fluentIn].filter((part): part is string => !!part);
// A recommendation's paragraphs: split at blank lines, each line break inside
// one read as a space.
const paragraphs = (text: string) =>
  text.trim().split(/\n\s*\n/).map((p) => p.replace(/\s*\n\s*/g, ' '));
// The first recommendation that goes on paper, or -1 if none does.
const firstPrinted = cv.recommendations.findIndex((rec) => rec.print);

const origin = Astro.site ?? Astro.url;
const abs = (path: string) => new URL(withBase(path), origin).toString();
const pageUrl = new URL(Astro.url.pathname, origin).toString();
const personId = `${abs('/')}#person`;

// Enrich the shared Person node (merged by @id) with CV facts, and describe the
// page itself as a ProfilePage.
const jsonLd = [
  {
    '@type': 'Person',
    '@id': personId,
    ...(cv.experience[0]?.org
      ? { worksFor: { '@type': 'Organization', name: cv.experience[0].org } }
      : {}),
    alumniOf: cv.education
      .filter((e) => e.org)
      .map((e) => ({ '@type': 'EducationalOrganization', name: e.org })),
    ...(cv.location
      ? { address: { '@type': 'PostalAddress', addressLocality: cv.location } }
      : {}),
    ...(languages.length ? { knowsLanguage: languages } : {}),
    ...(cv.skills.length ? { knowsAbout: cv.skills } : {}),
  },
  {
    '@type': 'ProfilePage',
    '@id': `${pageUrl}#profilepage`,
    url: pageUrl,
    name: `About/CV — ${name}`,
    isPartOf: { '@id': `${abs('/')}#website` },
    mainEntity: { '@id': personId },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Map', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'About & CV', item: pageUrl },
    ],
  },
];
---

<Base
  title="About & CV"
  description={`Curriculum vitae of ${name}, ${headline}.`}
  ogType="profile"
  jsonLd={jsonLd}
>
  <article data-print-title={`${name} — CV`}>
    <PageNav>
      <li><a href={withBase('/')}>Back to map</a></li>
      <li><button class="link" type="button" data-print>Download PDF</button></li>
    </PageNav>

    <header data-reveal>
      <div>
        <h1>{name}</h1>
        {/* Each part stays whole and the slash ends the line it's on, so a narrow
            screen wraps after "Portugal /" rather than mid-phrase. */}
        {
          facts.length > 0 && (
            <p class="meta">
              {facts.map((part, i) => <>{i > 0 && '\u00a0/ '}<span>{part}</span></>)}
            </p>
          )
        }
        <p>{headline}</p>
        {/* On paper there are no links to click, so the contacts are spelled out
            on one line, dot-separated (the dots are CSS), each kept whole. The
            email is filled in by script (see src/scripts/site.ts) so it is never
            in the shipped HTML. */}
        <p class="print-only">
          {printContacts.map((c) => (c.token ? <span data-email={c.token} data-email-text></span> : <span>{c.text}</span>))}
        </p>
      </div>

      <ul class="no-print" role="list">
        {site.socials.map((s) => (
          <li><a href={s.href} data-email={s.token}>{s.label}</a></li>
        ))}
      </ul>
    </header>

    <div class="summary" data-reveal style="--reveal-step: 1">
      <Fragment set:html={summary} />
    </div>

    {/* Each section's <h2> lives inside its first entry's .entry-keep, so a
        printed page can never end on a section title (see the print styles). */}
    {
      jobSections.map(
        (section) =>
          section.jobs.length > 0 && (
            <section
              id={section.id}
              data-reveal
              style={section.step ? `--reveal-step: ${section.step}` : undefined}
            >
              {section.jobs.map((job, i) => (
                <div class="entry">
                  <div class="entry-keep">
                    {i === 0 && <h2>{section.title}</h2>}
                    <p class="period">{job.period}</p>
                    <div>
                      <h3>{job.role}, {job.org}</h3>
                      {job.summary && <p>{job.summary}</p>}
                      {job.points.length > 0 && (
                        <ul>
                          {job.points.slice(0, 1).map((point) => <li>{point}</li>)}
                        </ul>
                      )}
                    </div>
                  </div>
                  {job.points.length > 1 && (
                    <ul>
                      {job.points.slice(1).map((point) => <li>{point}</li>)}
                    </ul>
                  )}
                  {(job.caseStudies.length > 0 || job.images.length > 0) && (
                    <div class="entry-extras no-print">
                      {job.caseStudies.length > 0 && (
                        <div>
                          <p class="meta">Case studies:</p>
                          <ul role="list">
                            {job.caseStudies.map((study) => (
                              <li><a href={study.href}>{study.title}</a></li>
                            ))}
                          </ul>
                        </div>
                      )}
                      {job.images.length > 0 && (
                        <ul role="list">
                          {job.images.map((image) => (
                            <li>
                              <a
                                href={image.url}
                                data-enlarge
                                style={`--w: ${image.width}; --ratio: ${image.width / image.height}`}
                              >
                                <span class="visually-hidden">Enlarge image:</span>
                                <img
                                  src={image.thumb}
                                  srcset={image.srcset}
                                  sizes={image.srcset && image.sizes}
                                  alt={image.alt}
                                  width={image.width}
                                  height={image.height}
                                  loading="lazy"
                                  decoding="async"
                                />
                              </a>
                            </li>
                          ))}
                        </ul>
                      )}
                    </div>
                  )}
                </div>
              ))}
            </section>
          )
      )
    }

    <section id="education" data-reveal>
      {
        cv.education.map((entry, i) => (
          <div class="entry">
            <div class="entry-keep">
              {i === 0 && <h2>Education</h2>}
              <p class="period">{entry.period}</p>
              <div>
                <h3>{entry.title}</h3>
                <p>{entry.org}</p>
                {entry.note && <p>{entry.note}</p>}
              </div>
            </div>
          </div>
        ))
      }
    </section>

    {/* Each quote is a figure, the recommender its caption. A whole
        recommendation stays on one printed page, and one marked
        `print: false` stays off it. When the first is off paper, the title
        is repeated for print in the first one that isn't. */}
    {
      cv.recommendations.length > 0 && (
        <section id="recommendations" class:list={{ 'no-print': firstPrinted < 0 }} data-reveal>
          {cv.recommendations.map((rec, i) => (
            <div class:list={['entry', { 'no-print': !rec.print }]}>
              <div class="entry-keep">
                {i === 0 && <h2>Recommendations</h2>}
                {i > 0 && i === firstPrinted && <h2 class="print-only">Recommendations</h2>}
                <p class="period">{rec.date}</p>
                <figure>
                  <blockquote>
                    {paragraphs(rec.text).map((p) => <p>{p}</p>)}
                  </blockquote>
                  <figcaption>
                    <span>{rec.name}</span>
                    <span>{[rec.role, rec.org].filter(Boolean).join(', ')}</span>
                  </figcaption>
                </figure>
              </div>
            </div>
          ))}
        </section>
      )
    }
  </article>

  {hasImages && <Lightbox />}

  <MiniMap slot="footer" />

  {/* The one page of the portfolio that points to the UX audit, from the
      footer, so the printed CV never shows it. It opens in a new tab, since
      it's a page for clients, apart from the portfolio: whoever is reading
      the CV keeps it open. */}
  <li slot="footer-links"><a href={withBase('/services/ux-audit/')} target="_blank">Hands-on UX audit</a></li>
</Base>

<style>
  /* --- Knobs: the CV's vertical rhythm, in one place. On a phone the title
     gap is corrected for the one-column grid further down. */
  article {
    --cv-section-gap: calc(var(--space-lg) + var(--space-md)); /* above a section title */
    --cv-title-gap: calc(var(--space-md) + var(--space-sm)); /* below the title's rule */
    --cv-entry-gap: calc(var(--space-md) + var(--space-sm)); /* between entries */
    --cv-extras-gap: var(--space-md); /* above a job's case-study links and thumbnails */
    --cv-extras-after: calc(var(--space-lg) + var(--space-md)); /* below them, before the next job */
    --cv-thumb-height: 4.5rem; /* a thumbnail's height (THUMB_HEIGHT_HINT follows it) */
    --cv-map-gap: var(--space-xl); /* extra room between the last section and the mini-map */
    --cv-quote-paragraph-gap: var(--space-sm); /* between a recommendation's paragraphs */
    --cv-quote-sign-gap: var(--space-md); /* between a recommendation and who wrote it */
  }

  /* Name block, then the links below it, however short the headline is. */
  header {
    display: grid;
    gap: var(--space-lg);
  }

  h1 {
    margin-block-end: var(--space-xs);
  }

  /* Space between the location line and the headline. */
  h1 + .meta {
    margin-block-end: var(--space-md);
  }

  /* The headline: the one plain paragraph beside the name (not the location
     line, not the printed contacts). */
  header > div > p:not(.meta, .print-only) {
    font-weight: var(--weight-semibold);
  }

  header .meta span {
    display: inline-block;
  }

  .summary {
    margin-block-start: var(--space-lg);
  }

  /* The summary is rendered Markdown, so its paragraphs and lists aren't
     scoped to this file and need :global(). Lists match the job bullets. */

  .summary > :global(* + *) {
    margin-block-start: var(--space-md);
  }

  .summary :global(ul) {
    display: grid;
    gap: var(--space-sm);
    padding: 0;
    list-style: square;
  }

  .summary :global(li::marker) {
    font-size: var(--step--1);
    color: var(--ink-3);
  }

  section {
    margin-block-start: var(--cv-section-gap);
  }

  /* On screen only: the mini-map isn't printed, and a trailing margin could
     spill onto a blank page. */
  @media screen {
    section:last-of-type {
      margin-block-end: var(--cv-map-gap);
    }
  }

  h2 {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    padding-block-end: var(--space-sm);
    margin-block-end: var(--cv-title-gap);
    border-block-end: 1px solid var(--line-strong);
  }

  /* The title sits inside the first entry (so print keeps them together);
     on screen it spans both columns above the dates. */
  .entry h2 {
    grid-column: 1 / -1;
  }

  /* Dates in a fixed column, the job beside them. `.entry-keep` unwraps on
     screen so the grid still sees the date and the body as its two children. */

  .entry {
    display: grid;
    grid-template-columns: 9rem 1fr;
    column-gap: var(--space-lg);
  }

  .entry-keep {
    display: contents;
  }

  .entry + .entry {
    margin-block-start: var(--cv-entry-gap);
  }

  .period {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    line-height: var(--leading-tight);
    color: var(--ink-3);
    padding-block-start: 0.4375rem;
    text-wrap: balance;
  }

  /* A job's summary sits as far below the title as its first bullet would.
     Education's school line stays tight under its title. */
  #experience h3 + p,
  #earlier-work h3 + p {
    margin-block-start: var(--space-sm);
  }

  /* The bullets: the first beside the title, the rest below. Not the rows of
     links and thumbnails under them, which are lists too. */
  .entry-keep ul,
  .entry > ul {
    margin-block-start: var(--space-sm);
    display: grid;
    gap: var(--space-sm);
    padding: 0;
    list-style: square;
  }

  .entry > ul {
    grid-column: 2;
  }

  .entry li::marker {
    font-size: var(--step--1);
    color: var(--ink-3);
  }

  /* A job's case studies, then its thumbnails, in the body column. They sit
     close under its bullets and the next job further off, so they read as
     this job's. Screen only: the PDF leaves them, and that room, out. */
  .entry-extras {
    grid-column: 2;
    display: grid;
    gap: var(--space-md);
    margin-block-start: var(--cv-extras-gap);
  }

  @media screen {
    .entry:has(> .entry-extras) + .entry {
      margin-block-start: var(--cv-extras-after);
    }
  }

  /* "Case studies:", with the links just under it. */
  .entry-extras .meta + ul {
    margin-block-start: var(--space-sm);
  }

  /* Thumbnails at one height, each in its own shape, framed like a case
     study's screenshots. A click opens the enlarged view (Lightbox.astro). */
  .entry-extras ul:has(img) {
    gap: var(--space-sm);
  }

  .entry-extras a:has(img) {
    display: block;
    cursor: zoom-in;
  }

  .entry-extras img {
    width: auto;
    height: var(--cv-thumb-height);
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    transition: border-color var(--dur-fast) var(--ease);
  }

  .entry-extras a:hover img {
    border-color: var(--line-strong);
  }

  /* Recommendations: the date where a job's dates go, the quote in the body
     column, in italic and softer ink like a case study's quotes. Its opening
     mark hangs outside the text, so the words line up with the jobs above;
     the recommender signs off beneath in the page's own voice, name over role. */

  blockquote {
    position: relative;
    font-style: italic;
    color: var(--ink-2);
    quotes: '“' '”';
  }

  blockquote p + p {
    margin-block-start: var(--cv-quote-paragraph-gap);
  }

  blockquote p:first-child::before {
    content: open-quote;
    position: absolute;
    inset-inline-end: 100%;
  }

  blockquote p:last-child::after {
    content: close-quote;
  }

  figcaption {
    display: grid;
    margin-block-start: var(--cv-quote-sign-gap);
  }

  figcaption span:first-child {
    font-weight: var(--weight-semibold);
  }

  figcaption span + span {
    color: var(--ink-2);
  }

  @media (width <= 640px) {
    .entry {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }

    .entry > ul {
      grid-column: 1;
      margin-block-start: 0;
    }

    .entry-extras {
      grid-column: 1;
      margin-block-start: calc(var(--cv-extras-gap) - var(--space-sm));
    }

    /* The one-column grid adds its gap under the title too. */
    .entry h2 {
      margin-block-end: calc(var(--cv-title-gap) - var(--space-sm));
    }
  }

  /* This page is the CV, so it has to fall onto A4 cleanly: no column limit, a
     printable contact block, and page breaks that never split a bullet. */

  @media print {
    article {
      font-size: 12pt;
    }

    /* One row of contacts. The dots are drawn here, with --contact-gap on each
       side; a long row wraps between contacts, the dot ending the line. */
    header .print-only {
      --contact-gap: var(--space-md);

      display: flex;
      flex-wrap: wrap;
      column-gap: var(--contact-gap);
      font-size: 12pt;
      padding-block: 5mm;
      margin-block-start: 5mm;
      border-block: 1px solid #000;
    }

    header .print-only span {
      white-space: nowrap;
    }

    header .print-only span:not(:last-child)::after {
      content: '·';
      margin-inline-start: var(--contact-gap);
    }

    .summary {
      margin-block-start: 5mm;
    }

    .summary :global(ul) {
      display: block;
      padding-inline-start: 1em;
    }

    .summary :global(li) {
      break-inside: avoid;
    }

    .summary :global(li + li) {
      margin-block-start: var(--space-sm);
    }

    .summary :global(li::marker) {
      color: #000;
    }

    section,
    .entry,
    .entry ul {
      break-inside: auto;
    }

    .entry {
      display: block;
    }

    /* The dates, title, summary and first bullet of a job never split, and in
       a section's first entry the section title joins them, so no title ends a
       page alone. The remaining bullets flow on, breaking only between bullets,
       so a long job can start low on a page instead of leaving it half empty. */
    .entry-keep {
      display: block;
      break-inside: avoid;
    }

    .period {
      margin-block-end: 0.25em;
    }

    .entry ul {
      display: block;
      padding-inline-start: 1em;
    }

    .entry > ul {
      margin-block-start: var(--space-sm);
    }

    .entry li {
      break-inside: avoid;
    }

    .entry li + li {
      margin-block-start: var(--space-sm);
    }

    .entry li::marker {
      color: #000;
    }

    /* When the recommendations before it stay off paper, the first printed
       one carries the title, so it sits where a section's first entry does. */
    #recommendations .entry:has(h2.print-only) {
      margin-block-start: 0;
    }
  }
</style>
