---
/** The enlarged view of a case study's media, one dialog for the whole page.
    A gallery thumbnail opens its screenshot here, as large as fits the window
    but never past its own size, and zooms from there. The arrows at the
    window's sides, or the arrow keys, step through every screenshot and
    video on the page in reading order, and the counter at the top says
    where you are; closing returns to the one last shown. A video plays here
    at no more than its own size, and doesn't zoom. Without the script, a
    thumbnail is a plain link to its image. */
---

<dialog aria-label="Enlarged view">
  <div>
    <p aria-live="polite"></p>
    <button type="button" class="link" data-zoom="in">Zoom in</button>
    <button type="button" class="link" data-zoom="out"><span class="visually-hidden">Zoom </span>Out</button>
    <button type="button" class="link" data-zoom="fit">Fit<span class="visually-hidden"> to window</span></button>
    <button type="button" class="link" data-close>Close</button>
  </div>
  <div data-stage></div>
  <button type="button" data-step="-1" aria-label="Previous" aria-keyshortcuts="ArrowLeft">
    <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M10 3 5 8l5 5" />
    </svg>
  </button>
  <button type="button" data-step="1" aria-label="Next" aria-keyshortcuts="ArrowRight">
    <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="m6 3 5 5-5 5" />
    </svg>
  </button>
</dialog>

<script>
  // Shows the page's screenshots and videos in one dialog, in reading order.
  // A screenshot opens fitted to the window, and zooms there: a click or tap
  // zooms in where it lands and the next one zooms back out; a pinch, Ctrl or
  // ⌘ with the wheel, or the zoom buttons zoom by degrees, and the fit button
  // fits it to the window again. A zoomed screenshot pans by scrolling, or by
  // dragging it with the mouse. The browser's own pinch zoom is held off
  // inside the dialog, since it would carry the buttons off screen. A click
  // with a modifier key still follows the link, to open the file in a new tab.

  /** A knob from the dialog's stylesheet. */
  const knob = (element: Element, name: string, fallback: number) =>
    Number.parseFloat(getComputedStyle(element).getPropertyValue(name)) || fallback;

  /** How far apart two fingers are, and the point halfway between them. */
  const spread = (touches: TouchList) =>
    Math.hypot(touches[0].clientX - touches[1].clientX, touches[0].clientY - touches[1].clientY);
  const middle = (touches: TouchList) => ({
    x: (touches[0].clientX + touches[1].clientX) / 2,
    y: (touches[0].clientY + touches[1].clientY) / 2,
  });

  const dialog = document.querySelector<HTMLDialogElement>('dialog:has([data-stage])');
  const stage = dialog?.querySelector<HTMLElement>('[data-stage]');
  const count = dialog?.querySelector('p');
  const zoomIn = dialog?.querySelector('[data-zoom="in"]');
  const zoomOut = dialog?.querySelector('[data-zoom="out"]');
  const zoomFit = dialog?.querySelector('[data-zoom="fit"]');
  const close = dialog?.querySelector<HTMLButtonElement>('[data-close]');
  const previous = dialog?.querySelector<HTMLButtonElement>('[data-step="-1"]');
  const next = dialog?.querySelector<HTMLButtonElement>('[data-step="1"]');

  /** Every gallery thumbnail and every video in the text, in reading order. */
  const items = [...document.querySelectorAll<HTMLElement>('[data-gallery] > div > a, .prose figure > video')];

  if (dialog && stage && count && zoomIn && zoomOut && zoomFit && close && previous && next && items.length) {
    const step = knob(dialog, '--lightbox-zoom-step', 1.5);
    const most = knob(dialog, '--lightbox-max-zoom', 2);

    /** The item on show and its enlarged copy, the copy's own width in CSS
        pixels, whether it zooms, and how many times the size that fits the
        window it's shown at. */
    let current = 0;
    let shown: HTMLElement | SVGSVGElement | undefined;
    let own = 0;
    let zoomable = true;
    let zoom = 1;

    /** The size that fits the window, and the furthest zoom from it. */
    const fit = () => (shown ? shown.getBoundingClientRect().width / zoom : own);
    const limit = () => (zoomable ? Math.max(1, (own * most) / fit()) : 1);

    /** Zooms to `next`, putting the point at fractions (fx, fy) across the
        screenshot at (x, y) on screen. A zoom that nearly reaches either end
        lands on it. The stage only scrolls while zoomed, since a fitted
        screenshot has nothing to scroll to; so the state is set before the
        screenshot is measured, once any scrollbars are in. */
    const zoomAt = (target: number, fx: number, fy: number, x: number, y: number) => {
      if (!shown) return;
      const max = limit();
      zoom = target < 1.02 ? 1 : target > max / 1.02 ? max : target;
      stage.style.setProperty('--zoom', String(zoom));
      dialog.toggleAttribute('data-zoomed', zoom > 1);
      if (zoom === 1) {
        stage.scrollTo(0, 0);
      } else {
        const box = shown.getBoundingClientRect();
        stage.scrollLeft += box.left + fx * box.width - x;
        stage.scrollTop += box.top + fy * box.height - y;
      }
      zoomOut.setAttribute('aria-disabled', String(zoom === 1));
      zoomFit.setAttribute('aria-disabled', String(zoom === 1));
      zoomIn.setAttribute('aria-disabled', String(zoom >= limit() / 1.02));
      // A screenshot the window already shows at its furthest zoom has none.
      dialog.toggleAttribute('data-unzoomable', limit() < 1.02);
    };

    /** Back to the size that fits the window. */
    const reset = () => zoomAt(1, 0, 0, 0, 0);

    /** Zooms to `target`, keeping the point at (x, y) on screen where it is. */
    const zoomTo = (target: number, x: number, y: number) => {
      if (!shown) return;
      const box = shown.getBoundingClientRect();
      zoomAt(target, (x - box.left) / box.width, (y - box.top) / box.height, x, y);
    };

    /** Zooms by `factor` about the middle of the stage. */
    const zoomBy = (factor: number) => {
      const box = stage.getBoundingClientRect();
      zoomTo(zoom * factor, box.left + stage.clientWidth / 2, box.top + stage.clientHeight / 2);
    };

    /** Fetches a screenshot's full image ahead of time, so stepping to it
        shows it at once. */
    const warm = (index: number) => {
      const item = items[index];
      if (item instanceof HTMLAnchorElement && item.querySelector('img')) new Image().src = item.href;
    };

    /** Shows item `index`: a copy of its screenshot or video, fitted to the
        window. A video is as large as it shows on the page if its figure
        caps it there (`--inset-max`), else as large as its own frame. */
    const show = (index: number) => {
      current = index;
      const item = items[index];
      if (item instanceof HTMLVideoElement) {
        const video = item.cloneNode(true) as HTMLVideoElement;
        const capped = item.closest('figure.inset') && getComputedStyle(item.closest('figure')!).getPropertyValue('--inset-max');
        own = capped ? item.getBoundingClientRect().width : item.width;
        video.style.setProperty('--w', String(own));
        video.style.setProperty('--ratio', String(item.width / item.height));
        item.pause();
        shown = video;
        zoomable = false;
      } else {
        const art = item.querySelector<HTMLImageElement | SVGSVGElement>('img, svg[role="img"]');
        if (!art) return;
        // The thumbnail may have loaded a smaller copy (`Gallery.astro`), so a
        // screenshot is a new image of the link's full file, not a clone that
        // would carry the thumbnail's choice of sizes along.
        let copy: HTMLImageElement | SVGSVGElement;
        if (art instanceof HTMLImageElement) {
          copy = document.createElement('img');
          for (const name of ['alt', 'width', 'height']) copy.setAttribute(name, art.getAttribute(name) ?? '');
          copy.decoding = 'async';
          copy.draggable = false;
          copy.src = (item as HTMLAnchorElement).href;
        } else {
          copy = art.cloneNode(true) as SVGSVGElement;
        }
        for (const name of ['--w', '--ratio']) copy.style.setProperty(name, item.style.getPropertyValue(name));
        own = Number.parseFloat(item.style.getPropertyValue('--w'));
        shown = copy;
        zoomable = true;
      }
      stage.replaceChildren(shown);
      count.textContent = `${index + 1} of ${items.length}`;
      previous.setAttribute('aria-disabled', String(index === 0));
      next.setAttribute('aria-disabled', String(index === items.length - 1));
      reset();
      warm(index + 1);
      warm(index - 1);
    };

    /** Steps `by` items along, if there's one there. */
    const go = (by: number) => {
      const target = current + by;
      if (target >= 0 && target < items.length) show(target);
    };

    // A page with a single item has nowhere to step to.
    const alone = items.length < 2;
    count.hidden = alone;
    previous.hidden = alone;
    next.hidden = alone;

    items.forEach((item, index) => {
      if (!(item instanceof HTMLAnchorElement)) return;
      item.addEventListener('click', (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        show(index);
        dialog.showModal();
        close.focus();
        reset();
      });
    });

    close.addEventListener('click', () => dialog.close());
    zoomIn.addEventListener('click', () => zoomBy(step));
    zoomOut.addEventListener('click', () => zoomBy(1 / step));
    zoomFit.addEventListener('click', reset);
    previous.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    window.addEventListener('resize', () => {
      if (dialog.open) zoomBy(1);
    });

    // The arrow keys step, except inside a video, where they seek.
    dialog.addEventListener('keydown', (event) => {
      if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
      if ((event.target as Element).closest('video')) return;
      if (event.key === 'ArrowLeft') go(-1);
      else if (event.key === 'ArrowRight') go(1);
      else return;
      event.preventDefault();
    });

    // Closing stops the copy, and leaves focus, and the page, on the item
    // last shown, so stepping through ends where the reader stopped.
    dialog.addEventListener('close', () => {
      stage.replaceChildren();
      shown = undefined;
      items[current].focus();
    });

    // A click on the screenshot zooms in to its own size, or by a step if
    // that's further. Once zoomed, any click zooms back out; beside a fitted
    // screenshot, it closes the dialog. A video keeps its clicks for its own
    // controls.
    let dragged = false;
    stage.addEventListener('click', (event) => {
      if (dragged) return;
      const onArt = shown?.contains(event.target as Node);
      if (onArt && !zoomable) return;
      if (zoom > 1) zoomTo(1, event.clientX, event.clientY);
      else if (onArt) zoomTo(Math.max(own / fit(), step), event.clientX, event.clientY);
      else dialog.close();
    });

    // The mouse drags a zoomed screenshot around; a drag isn't a click.
    let drag: { x: number; y: number; left: number; top: number } | undefined;
    stage.addEventListener('pointerdown', (event) => {
      dragged = false;
      if (event.pointerType !== 'mouse' || event.button !== 0 || zoom === 1) return;
      if (!shown?.contains(event.target as Node)) return;
      drag = { x: event.clientX, y: event.clientY, left: stage.scrollLeft, top: stage.scrollTop };
      stage.setPointerCapture(event.pointerId);
    });
    stage.addEventListener('pointermove', (event) => {
      if (!drag) return;
      const dx = event.clientX - drag.x;
      const dy = event.clientY - drag.y;
      if (!dragged && Math.hypot(dx, dy) < 4) return;
      dragged = true;
      dialog.toggleAttribute('data-dragging', true);
      stage.scrollLeft = drag.left - dx;
      stage.scrollTop = drag.top - dy;
    });
    const drop = () => {
      drag = undefined;
      dialog.removeAttribute('data-dragging');
    };
    stage.addEventListener('pointerup', drop);
    stage.addEventListener('pointercancel', drop);

    // Ctrl or ⌘ with the wheel zooms about the pointer, and so does a pinch on
    // a trackpad, which Chrome and Firefox send as Ctrl with the wheel.
    dialog.addEventListener(
      'wheel',
      (event) => {
        if (!event.ctrlKey && !event.metaKey) return;
        event.preventDefault();
        const delta = event.deltaMode === WheelEvent.DOM_DELTA_LINE ? event.deltaY * 16 : event.deltaY;
        zoomTo(zoom * Math.exp(-Math.max(-50, Math.min(50, delta)) / 100), event.clientX, event.clientY);
      },
      { passive: false },
    );

    // Two fingers zoom, and the point first between them stays between them,
    // so they can pan as they pinch. One finger scrolls as usual.
    let pinch: { zoom: number; spread: number; fx: number; fy: number } | undefined;
    dialog.addEventListener(
      'touchstart',
      (event) => {
        if (event.touches.length !== 2 || !shown) return;
        const { x, y } = middle(event.touches);
        const box = shown.getBoundingClientRect();
        pinch = {
          zoom,
          spread: Math.max(1, spread(event.touches)),
          fx: (x - box.left) / box.width,
          fy: (y - box.top) / box.height,
        };
      },
      { passive: true },
    );
    dialog.addEventListener(
      'touchmove',
      (event) => {
        if (!pinch || event.touches.length !== 2) return;
        event.preventDefault();
        const { x, y } = middle(event.touches);
        zoomAt((pinch.zoom * spread(event.touches)) / pinch.spread, pinch.fx, pinch.fy, x, y);
      },
      { passive: false },
    );
    const lift = (event: TouchEvent) => {
      if (event.touches.length < 2) pinch = undefined;
    };
    dialog.addEventListener('touchend', lift);
    dialog.addEventListener('touchcancel', lift);

    // Safari pinches with its own gesture events: on a trackpad they zoom
    // here; on a touch screen the touch events above already do, so these
    // only keep Safari from zooming the page.
    let gesture = 1;
    dialog.addEventListener('gesturestart', (event) => {
      event.preventDefault();
      gesture = zoom;
    });
    dialog.addEventListener('gesturechange', (event) => {
      event.preventDefault();
      if (pinch) return;
      const { scale, clientX, clientY } = event as Event & { scale: number; clientX: number; clientY: number };
      zoomTo(gesture * scale, clientX, clientY);
    });
  }
</script>

<style>
  dialog {
    /* A screenshot fits the window, never past its own size. Each zoom
       button multiplies its size by the step, and a click zooms it to its
       own size, or by a step if that's further. Nothing zooms past the max,
       in times its own size: at 1, the furthest zoom is the size it was on
       screen, pixel for pixel on the display it was taken on, so it reads as
       well as the real thing and no better. The script reads these two. */
    --lightbox-zoom-step: 1.5;
    --lightbox-max-zoom: 1;

    /* The previous and next buttons at the window's sides: the square's
       size, the arrow's size, and the gap from the window's edge. From 40rem
       the stage keeps clear of them. Below that, on a phone or a narrow
       window, they sit over the screenshot's edges and take the `-narrow`
       values instead. */
    --lightbox-nav: 2.5rem;
    --lightbox-nav-icon: 1.25rem;
    --lightbox-nav-inset: var(--gutter);
    --lightbox-nav-narrow: 2rem;
    --lightbox-nav-icon-narrow: 1.25rem;
    --lightbox-nav-inset-narrow: var(--space-xs);

    /* The dialog fills the visible window: the counter and buttons along
       the top, below them the stage, which scrolls a zoomed screenshot, and
       the step buttons over its sides. Neither allows the browser's pinch
       zoom; the script zooms the screenshot instead. */
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--paper);
    overflow: hidden;
    touch-action: pan-x pan-y;
  }

  dialog[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    animation: lightbox-in var(--dur-fast) var(--ease);
  }

  dialog::backdrop {
    background: var(--paper);
  }

  dialog > div:first-child {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    padding: var(--space-md) var(--gutter);
  }

  /* The counter takes the left, and pushes the buttons right. */
  dialog > div:first-child > p {
    margin: 0 auto 0 0;
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-mono);
    font-variant-numeric: tabular-nums;
  }

  dialog > div:first-child > p[hidden] + button {
    margin-inline-start: auto;
  }

  /* A button that can't act takes the faint ink, lighter than any text. */
  dialog > div:first-child > button[aria-disabled='true'] {
    color: var(--ink-faint);
    cursor: default;
  }

  dialog > div:last-of-type {
    container-type: size;
    display: grid;
    padding: 0 var(--gutter) var(--gutter);
    overflow: hidden;
    overscroll-behavior: contain;
    touch-action: pan-x pan-y;
  }

  @media (width >= 40rem) {
    dialog > div:last-of-type {
      padding-inline: calc(var(--lightbox-nav-inset) + var(--lightbox-nav) + var(--gutter));
    }
  }

  dialog[data-zoomed] > div:last-of-type {
    overflow: auto;
  }

  /* The size that fits is the smallest of its own size (`--w`), the stage's
     width, and the width its height allows; the script's `--zoom` multiplies
     it. Auto margins centre it while it fits and let it scroll from its start
     once it doesn't. Each new one fades in, so a step reads as a step. */
  dialog > div:last-of-type > :global(img),
  dialog > div:last-of-type > :global(svg),
  dialog > div:last-of-type > :global(video) {
    width: calc(min(var(--w) * 1px, 100cqi, 100cqb * var(--ratio)) * var(--zoom, 1));
    max-width: none;
    height: auto;
    margin: auto;
    cursor: zoom-in;
    -webkit-user-select: none;
    user-select: none;
    animation: lightbox-in var(--dur-fast) var(--ease);
  }

  dialog[data-zoomed] > div:last-of-type > :global(img),
  dialog[data-zoomed] > div:last-of-type > :global(svg) {
    cursor: zoom-out;
  }

  dialog[data-unzoomable] > div:last-of-type > :global(*) {
    cursor: auto;
  }

  dialog[data-dragging] > div:last-of-type > :global(img),
  dialog[data-dragging] > div:last-of-type > :global(svg) {
    cursor: grabbing;
  }

  /* Previous on the left, next on the right, halfway down the window: paper
     squares framed like the gallery's enlarge marker, in the second ink, and
     in the accent on hover. At either end of the page, the way that's
     closed takes the faint ink. */
  dialog > button {
    position: absolute;
    inset-block-start: 50%;
    display: grid;
    place-items: center;
    width: var(--lightbox-nav);
    height: var(--lightbox-nav);
    padding: 0;
    color: var(--ink-2);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    translate: 0 -50%;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  dialog > button:nth-of-type(1) {
    inset-inline-start: var(--lightbox-nav-inset);
  }

  dialog > button:nth-of-type(2) {
    inset-inline-end: var(--lightbox-nav-inset);
  }

  dialog > button:hover {
    color: var(--accent);
    border-color: var(--line-strong);
  }

  dialog > button[aria-disabled='true'] {
    color: var(--ink-faint);
    border-color: var(--line);
    cursor: default;
  }

  dialog > button[hidden] {
    display: none;
  }

  dialog > button > svg {
    width: var(--lightbox-nav-icon);
    height: var(--lightbox-nav-icon);
  }

  @media (width < 40rem) {
    dialog > button {
      width: var(--lightbox-nav-narrow);
      height: var(--lightbox-nav-narrow);
    }

    dialog > button:nth-of-type(1) {
      inset-inline-start: var(--lightbox-nav-inset-narrow);
    }

    dialog > button:nth-of-type(2) {
      inset-inline-end: var(--lightbox-nav-inset-narrow);
    }

    dialog > button > svg {
      width: var(--lightbox-nav-icon-narrow);
      height: var(--lightbox-nav-icon-narrow);
    }
  }

  :global(html:has(dialog[open])) {
    overflow: hidden;
  }

  @keyframes lightbox-in {
    from {
      opacity: 0;
    }
  }
</style>
