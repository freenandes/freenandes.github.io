---
/** Home: an interactive map of the site. Markers, copy and connections are all
    in `src/diagram.config.ts`, except that a case study's label, tags and link
    come from its project (`src/lib/diagram.ts`); the physics that places them
    is in `src/scripts/nav-diagram.ts`. */

import { basename } from 'node:path';
import type { ImageMetadata } from 'astro';
import type { SvgComponent } from 'astro/types';
import Ruler from '../assets/ruler.svg';
import Base from '../layouts/Base.astro';
import type { DiagramNode, NodeKind } from '../diagram.config';
import { withBase } from '../lib/base';
import { getDiagramNodes, polygon } from '../lib/diagram';
import { site } from '../site.config';

const nodes = await getDiagramNodes();

// Every drawing in this folder lands on the map's texture, with nothing else to
// wire up. Each is drawn in `currentColor`, so `.decor` below colours them all,
// and each has its own width knob below, named after its file.
const decorations = Object.entries(
  import.meta.glob<SvgComponent & ImageMetadata>('../assets/decor/*.svg', {
    eager: true,
    import: 'default',
  }),
).map(([path, Drawing]) => ({ Drawing, name: basename(path, '.svg') }));

/** Circle just big enough to carry `label` once around, with a gap. */
function ring(label: string) {
  const FONT = 12;
  const advance = FONT * 0.725;
  const textLength = Math.max(label.length * advance, 90);
  const r = (textLength + 4 * advance) / (2 * Math.PI);
  const size = Math.round(2 * (r + FONT * 1.25));
  const c = size / 2;
  return {
    textLength: textLength.toFixed(2),
    size,
    d: `M ${c} ${(c - r).toFixed(2)} a ${r.toFixed(2)} ${r.toFixed(2)} 0 1 1 0 ${(2 * r).toFixed(2)} a ${r.toFixed(2)} ${r.toFixed(2)} 0 1 1 0 ${(-2 * r).toFixed(2)}`,
  };
}

// Two kinds of marker look different from the rest — the name at the centre of
// the map, and the decorative rings. Add a kind here to give it its own class.
const variant = (node: DiagramNode) =>
  node.kind === 'identity' || node.kind === 'floating' ? `node--${node.kind}` : undefined;

// Markers render in three runs so the case studies can be announced as a set.
// The wrappers are `display: contents` — they group, they don't lay out.
const pick = (...kinds: NodeKind[]) => nodes.filter((n) => kinds.includes(n.kind));
const runs: { label?: string; nodes: DiagramNode[] }[] = [
  { nodes: pick('identity', 'about', 'contact') },
  { label: 'Selected projects', nodes: pick('project') },
  { nodes: pick('floating') },
];
---

<Base footer={false} mainClass="home">
  <nav
    class="diagram"
    aria-label={`Site map — ${site.name}`}
    style={`--topo-pattern: url('${withBase('/topo-low.svg')}')`}
  >
    <svg class="links" aria-hidden="true" focusable="false"></svg>
    {
      runs.map((run) => (
        <div class="run" role={run.label ? 'group' : undefined} aria-label={run.label}>
          {run.nodes.map((node) => {
            const Heading = node.kind === 'identity' ? 'h1' : 'h2';
            const panelId = `panel-${node.id}`;
            const circle = node.kind === 'floating' ? ring(node.label) : null;
            return (
              <div
                class:list={['node', variant(node)]}
                data-id={node.id}
                aria-hidden={circle ? 'true' : undefined}
              >
                {circle ? (
                  <svg
                    style={`--ring-start: ${node.ringStart ?? 0}deg`}
                    viewBox={`0 0 ${circle.size} ${circle.size}`}
                    width={circle.size}
                    height={circle.size}
                    role="img"
                    aria-label={node.label}
                    focusable="false"
                  >
                    <defs>
                      <path id={`ring-${node.id}`} d={circle.d} fill="none" />
                    </defs>
                    <text>
                      <textPath
                        href={`#ring-${node.id}`}
                        startOffset="0"
                        textLength={circle.textLength}
                        lengthAdjust="spacingAndGlyphs"
                      >
                        {node.label}
                      </textPath>
                    </text>
                  </svg>
                ) : (
                  <Heading>
                    <button
                      type="button"
                      aria-expanded={node.kind === 'identity' ? undefined : 'false'}
                      aria-controls={node.kind === 'identity' ? undefined : panelId}
                    >
                      {/* Sized for a page whose stylesheet hasn't loaded. */}
                      <svg
                        viewBox="0 0 20 20"
                        width="16"
                        height="16"
                        aria-hidden="true"
                        focusable="false"
                      >
                        <polygon points={polygon(node.shape)} />
                      </svg>
                      <span>{node.label}</span>
                      {node.subLabel && <span>{node.subLabel}</span>}
                    </button>
                  </Heading>
                )}

                {node.kind !== 'identity' && !circle && (
                  <div class="panel" id={panelId} role="group" aria-label={node.label}>
                    {node.tagline && <p class="lead">{node.tagline}</p>}
                    {node.lines?.map((line) => <p>{line}</p>)}
                    {!!node.tags?.length && (
                      <ul class="meta-row" role="list">
                        {node.tags.map((tag) => <li class="meta">{tag}</li>)}
                      </ul>
                    )}
                    {node.kind === 'contact' && (
                      <ul role="list">
                        {site.socials.map((s) => (
                          <li>
                            <a
                              href={s.href}
                              data-email={s.token}
                              rel={s.href?.startsWith('http') ? 'me noopener' : undefined}
                            >
                              {s.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                    {node.link && (
                      <a
                        href={node.link.external ? node.link.href : withBase(node.link.href)}
                        {...(node.link.external ? { target: '_blank', rel: 'noopener' } : {})}
                      >
                        {node.link.label}
                      </a>
                    )}
                  </div>
                )}
              </div>
            );
          })}
        </div>
      ))
    }
    {/* The drawings and the ruler come after the markers, so a page that paints
        before its stylesheet shows the map's content first. Their zero size
        holds until the stylesheet gives them theirs, so they can't flash in
        unstyled at full width. */}
    {
      decorations.map(({ Drawing, name }) => (
        <Drawing
          class="decor"
          width="0"
          height="0"
          style={`--decor-frame: ${Drawing.width}; --decor-width: var(--decor-${name})`}
          aria-hidden="true"
          focusable="false"
        />
      ))
    }
    <Ruler
      class="ruler"
      width="0"
      height="0"
      preserveAspectRatio="xMaxYMax meet"
      aria-hidden="true"
      focusable="false"
    />
  </nav>
</Base>

<noscript>
  <style>
    /* No-JS fallback: collapse the simulation into a plain, readable list.
       It still fills the screen, so the contour texture does too. */
    .diagram {
      display: flex;
      flex-direction: column;
      height: auto !important;
      min-height: 100svh !important;
      padding: var(--space-md) !important;
    }

    .links {
      display: none !important;
    }

    .node {
      position: static !important;
      transform: none !important;
      display: flex !important;
      flex-direction: column;
      align-items: center;
      width: 100%;
      max-width: 40rem;
      margin-inline: auto;
      margin-block-end: var(--space-lg);
    }

    .panel {
      position: static !important;
      opacity: 1 !important;
      visibility: visible !important;
      translate: none !important;
      pointer-events: auto !important;
      margin-block-start: var(--space-sm);
    }

    /* The entrance is held until the script has placed the map, so without
       scripting there is nothing to wait for. */

    .node,
    .node button svg {
      animation: none !important;
    }
  </style>
</noscript>

<style>
  /* --- Knobs and canvas ------------------------------------------------ */

  /* The custom properties are this page's own values, in one place. Shared
     ones (colour, type, space, motion) are in tokens.css; spacing, physics and
     entrance timing of the layout are in KNOBS at the top of
     src/scripts/nav-diagram.ts. */

  .diagram {
    --topo-size: 150rem; /* width of one tile of the contour texture */
    --topo-opacity: 0.1;
    --marker-size: 1rem;
    --marker-size-identity: 1.25rem; /* the name at the centre */
    --link-width: 1.375; /* connector stroke */
    --card-width: 20rem; /* widest a card gets (never more than 90vw) */
    --ring-turn: 30s; /* one full turn of a floating ring */

    /* Each drawing's width, named after its file in src/assets/decor/. */
    --decor-flag: 4rem;
    --decor-compass: 14rem;
    --decor-kraken: 11rem;

    /* The size of a drawing with no width above, per unit of its viewBox. */
    --decor-scale: calc(4rem / 400);

    --ruler-height: 2.25rem;

    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 34rem;
    overflow: hidden;
    touch-action: pan-y;
  }

  /* Full-bleed: the map opts out of the reading column every other page has
     (global.css → Layout). */

  :global(main.home) {
    max-width: none;
    min-height: 100svh;
    padding-inline: 0;
    isolation: isolate;
  }

  /* Contour texture behind the map. `--topo-pattern` is set on the element so
     the asset path can follow the site's base path. */

  .diagram::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image: var(--topo-pattern);
    background-repeat: repeat;
    background-position: top center;
    background-size: var(--topo-size) auto;
    opacity: var(--topo-opacity);
  }

  @media print {
    .diagram::before {
      display: none;
    }
  }

  /* The drawings from src/assets/decor/ share the texture's layer and follow it
     in the tree, so they sit on it and under everything else, though they come
     after the markers. Their size here overrides the zero the markup gives them
     (the height follows the width through the viewBox). The script gives
     each a random spot clear of the map once the map has come to rest, and it
     stays there. One with no room stays hidden. */

  .decor {
    position: absolute;
    top: 0;
    left: 0;
    z-index: -1;
    width: var(--decor-width, calc(var(--decor-frame) * var(--decor-scale)));
    height: auto;
    color: var(--ink-decor);
    pointer-events: none;
    translate: var(--decor-x, 0) var(--decor-y, 0);
    opacity: 0;
  }

  .decor[data-placed] {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .decor[data-placed] {
      animation: node-in var(--dur) var(--ease);
    }
  }

  /* The ruler is on the same layer, but it's the map's scale, so it keeps to its
     corner and the script only keeps the drawings off it. A narrow screen shrinks
     it to fit, against the same corner. */

  .ruler {
    position: absolute;
    right: var(--space-md);
    bottom: var(--space-md);
    z-index: -1;
    width: auto;
    height: var(--ruler-height);
    max-width: calc(100% - 2 * var(--space-md));
    color: var(--ink-decor);
    pointer-events: none;
  }

  .links {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  /* Connectors are drawn by the script, so they are outside this scope. */

  .links :global(.link-line) {
    fill: none;
    stroke: var(--ink-3);
    stroke-width: var(--link-width);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Grouping only: no box, so markers still position against `.diagram`. */

  .run {
    display: contents;
  }

  /* --- Entrance --------------------------------------------------------- */

  /* The map draws itself once: markers land along the chain, then each
     connector is traced between the two it joins. The script sets the
     per-element delay and releases the hold only after it has solved the
     layout, so nothing animates in from a spot it is about to leave. */

  @media (prefers-reduced-motion: no-preference) {
    .node {
      animation: node-in var(--dur) var(--ease) var(--enter-delay, 0ms) backwards paused;
    }

    .node button svg {
      animation: dot-in var(--dur) var(--ease) var(--enter-delay, 0ms) backwards paused;
    }

    .links :global(.link-line) {
      animation: edge-draw var(--dur-slow) var(--ease) var(--enter-delay, 0ms) backwards paused;
    }

    .diagram.is-mounted .node,
    .diagram.is-mounted .node button svg,
    .diagram.is-mounted .links :global(.link-line) {
      animation-play-state: running;
    }
  }

  @keyframes node-in {
    from {
      opacity: 0;
    }
  }

  @keyframes dot-in {
    from {
      transform: scale(0.7);
    }
  }

  /* `pathLength="1"` (set by the script) makes these normalised units, so the
     trace holds up while the simulation is still nudging the endpoints. */

  @keyframes edge-draw {
    from {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }

    to {
      stroke-dasharray: 1;
      stroke-dashoffset: 0;
    }
  }

  /* --- Markers ---------------------------------------------------------- */

  .node {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    will-change: transform;
  }

  .node:has(button[aria-expanded='true']),
  .node.is-dragging {
    z-index: 6;
  }

  /* The headings give the page a real outline without changing the look: they
     wrap the existing button and inherit all typography from it. */

  h1,
  h2 {
    display: inline-flex;
    font: inherit;
    letter-spacing: inherit;
    text-wrap: nowrap;
  }

  .node button {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-sm);
    background: none;
    border: 0;
    color: var(--ink);
    cursor: grab;
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
  }

  .node.is-dragging button {
    cursor: grabbing;
  }

  .node button svg {
    width: var(--marker-size);
    height: var(--marker-size);
    overflow: visible;
    flex: none;
    transition: transform var(--dur-fast) var(--ease);
  }

  .node button polygon {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.75;
    vector-effect: non-scaling-stroke;
    transition: fill var(--dur-fast) var(--ease), stroke var(--dur-fast) var(--ease);
  }

  .node--identity button svg {
    width: var(--marker-size-identity);
    height: var(--marker-size-identity);
  }

  .node--identity button polygon {
    stroke-width: 2;
  }

  /* Hover and keyboard focus only light a marker up; a card opens on a click,
     or on Enter or Space, and the script records it in `aria-expanded`. */

  .node button:hover svg,
  .node button:focus-visible svg,
  .node button[aria-expanded='true'] svg {
    transform: scale(1.25);
  }

  .node button:hover polygon,
  .node button:focus-visible polygon,
  .node button[aria-expanded='true'] polygon {
    fill: var(--accent);
    stroke: var(--accent-ink);
  }

  /* Each label sits on a solid paper plate so connector lines are masked
     completely where they pass behind it. Labels never wrap on their own,
     but keep any line break diagram.config.ts writes into them. */

  .node button span {
    display: inline-block;
    padding-inline: 0.25em;
    background-color: var(--paper);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-2);
    white-space: pre;
    text-align: center;
    transition: color var(--dur-fast) var(--ease);
  }

  .node button:hover span,
  .node button:focus-visible span,
  .node button[aria-expanded='true'] span {
    color: var(--ink);
  }

  /* The name itself is set in the body face, not the label mono. Its second
     line (the job title) stays a label, so this targets the first span only. */

  .node--identity button span:first-of-type {
    font-family: var(--font-sans);
    font-size: var(--step-0);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    text-transform: none;
    color: var(--ink-2);
  }

  /* --- Floating rings --------------------------------------------------- */

  .node--floating {
    pointer-events: none;
    z-index: 0;
  }

  .node--floating svg {
    display: block;
    overflow: visible;
    transform-origin: center;
    transform: rotate(var(--ring-start, 0deg));
  }

  .node--floating text {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    fill: var(--ink-faint);
  }

  @keyframes ring-spin {
    from {
      transform: rotate(var(--ring-start, 0deg));
    }

    to {
      transform: rotate(calc(var(--ring-start, 0deg) - 360deg));
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .node--floating svg {
      animation: ring-spin var(--ring-turn) linear infinite;
    }
  }

  /* --- Cards ------------------------------------------------------------ */

  .panel {
    /* How far out the card starts when it is asked for, and goes back to as
       it leaves. */
    --shift: 0.5rem;

    position: absolute;

    /* The script works out where the card opens (see placePanel) and writes it
       as an offset from its marker's box. */
    left: var(--panel-x, 0);
    top: var(--panel-y, 100%);
    width: max-content;
    max-width: min(90vw, var(--card-width));
    padding: 0.875rem 1rem;
    background: var(--paper);
    outline: 1px solid var(--line-soft);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lift);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    translate: var(--arrive, 0);

    /* Leaving is quicker than arriving: a card you have closed should get out
       of the way, a card you asked for should settle. */
    transition: opacity var(--dur-fast) var(--ease),
      visibility var(--dur-fast) var(--ease), translate var(--dur-fast) var(--ease);
  }

  /* `data-place` is the side of its marker the script opened the card on. */

  .node[data-place='bottom'] .panel {
    --arrive: 0 var(--shift);
  }

  .node[data-place='top'] .panel {
    --arrive: 0 calc(-1 * var(--shift));
  }

  .node[data-place='right'] .panel {
    --arrive: var(--shift) 0;
  }

  .node[data-place='left'] .panel {
    --arrive: calc(-1 * var(--shift)) 0;
  }

  /* The card shows only while its button is expanded. It turns visible at
     once, so focus can move into it straight away, and fades in. It arrives by
     animation, not transition, so a card the script has just moved to another
     side arrives from that side. */

  .node:has(button[aria-expanded='true']) .panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    translate: 0;
    transition-property: opacity;
    transition-duration: var(--dur);
    animation: card-in var(--dur) var(--ease);
  }

  @keyframes card-in {
    from {
      translate: var(--arrive, 0);
    }
  }

  .panel p {
    font-size: var(--step-0);
    line-height: var(--leading-snug);
  }

  .panel .lead {
    font-weight: var(--weight-semibold);
    margin-block-end: var(--space-md);
  }

  .panel > ul,
  .panel > a {
    margin-block: var(--space-md) var(--space-xs);
  }

  .panel > a {
    display: inline-flex;
  }
</style>

<script>
  import { initDiagram } from '../scripts/nav-diagram';

  const root = document.querySelector<HTMLElement>('.diagram');
  if (root) initDiagram(root);
</script>
