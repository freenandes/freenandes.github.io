---
/** The footer: availability, contact links and copyright. A page can open it
    with something of its own, through Base's `footer` slot (the mini-map on
    About and the case studies), which then stands in for the rule, and add
    links of its own after the contact links through its `footer-links` slot
    (the `links` slot here). It's never printed (global.css). */

import { site } from '../site.config';

interface Props {
  /** Off drops the rule and the availability line that open the footer. */
  intro?: boolean;
}

const { intro = true } = Astro.props;
---

<footer class:list={{ plain: !intro }} data-reveal>
  <slot />
  <div>
    {intro && <p>{site.availability}</p>}
    <ul role="list">
      {site.socials.map((s) => (
        <li><a href={s.href} data-email={s.token}>{s.label}</a></li>
      ))}
      <slot name="links" />
    </ul>
    <p>© {new Date().getFullYear()} {site.name}</p>
  </div>
</footer>

<style>
  div {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    padding-block: var(--space-lg);
  }

  /* The rule sits on the inner box so it lines up with the text column rather
     than running out into the gutters. It only opens a footer that nothing
     else opens: the mini-map's line takes its place, and a page that drops
     the footer's intro (`plain`) has none. */

  footer:not(.plain) div:first-child {
    border-block-start: 1px solid var(--line-strong);
  }

  p:last-child {
    font-size: var(--step--1);
    font-weight: var(--weight-medium);
    color: var(--ink-3);
  }
</style>
