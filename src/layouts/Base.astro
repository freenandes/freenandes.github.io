---
/** The shell every page renders into: <head>, skip link, <main>, footer. A
    page's `footer` slot opens the footer, in place of its rule, and its `head`
    slot adds to the <head> (the home map's <noscript> styles). */

import { Font } from 'astro:assets';
import '../styles/global.css';
import { site } from '../site.config';
import { withBase } from '../lib/base';
import { svgIcon, icoIcon, appleTouchIcon } from '../lib/icons.mjs';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Class on <main>. Only the home page uses one, to go full-bleed. */
  mainClass?: string;
  /** Off on the diagram home — the map is the navigation. */
  footer?: boolean;
  /** Open Graph type for this page (e.g. "website", "profile", "article"). */
  ogType?: string;
  /** Extra schema.org nodes appended to the page's JSON-LD @graph. */
  jsonLd?: Record<string, unknown>[];
  /** Keeps the page out of search results, with no canonical address. The
      404 uses it: it's served at whatever address went missing. */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  mainClass,
  footer = true,
  ogType = 'website',
  jsonLd = [],
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const origin = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, origin).toString();
const siteBase = new URL(withBase('/'), origin).toString();
const ogImage = new URL(withBase(site.ogImage.path), origin).toString();

// Profiles the site owner can be cross-referenced by (schema.org sameAs).
const sameAs = site.socials
  .map((s) => s.href)
  .filter((href): href is string => href !== undefined && /^https?:/.test(href));

// Site-wide JSON-LD. Page-specific nodes (ProfilePage, CreativeWork,
// BreadcrumbList…) are appended via the `jsonLd` prop and share these @ids.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteBase}#website`,
      url: siteBase,
      name: site.name,
      description: site.description,
      inLanguage: site.locale,
      publisher: { '@id': `${siteBase}#person` },
    },
    {
      '@type': 'Person',
      '@id': `${siteBase}#person`,
      name: site.name,
      jobTitle: site.role,
      description: site.description,
      url: siteBase,
      image: ogImage,
      ...(sameAs.length ? { sameAs } : {}),
    },
    ...jsonLd,
  ],
};

// The Content Security Policy, as a <meta>: GitHub Pages can't send headers,
// so header-only directives (frame-ancestors and the like) can't be used.
// - style-src 'unsafe-inline': the `style="--…"` attributes, and the small
//   stylesheets Astro inlines (the fonts' @font-face rules among them).
// - script-src 'self': every script is bundled to a file (assetsInlineLimit in
//   astro.config.mjs).
// - No upgrade-insecure-requests in dev: a phone on `npm run dev -- --host`
//   reaches the dev server over http and would load nothing.
// - Deploy builds add the visit counter's origin to img-src; it's an image,
//   with the path and title in its query string, so nothing runs.
const countVisits = process.env.COUNT_VISITS === 'true';
const counter = new URL(site.visitCounter);
const counterSrc = `${counter}?${new URLSearchParams({ p: Astro.url.pathname, t: pageTitle })}`;

const csp = [
  "default-src 'self'",
  "base-uri 'self'",
  "object-src 'none'",
  "script-src 'self'",
  "style-src 'self' 'unsafe-inline'",
  "font-src 'self'",
  `img-src 'self' data:${countVisits ? ` ${counter.origin}` : ''}`,
  "connect-src 'self'",
  "form-action 'self'",
  "manifest-src 'self'",
  ...(import.meta.env.DEV ? [] : ['upgrade-insecure-requests']),
].join('; ');
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content={site.themeColor} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {noindex && <meta name="robots" content="noindex" />}

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    {!noindex && <link rel="canonical" href={canonical} />}

    {/* Open Graph only: X and the rest read these when they find no tags of
        their own. */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.ogLocale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content={site.ogImage.type} />
    <meta property="og:image:width" content={String(site.ogImage.width)} />
    <meta property="og:image:height" content={String(site.ogImage.height)} />
    <meta property="og:image:alt" content={site.ogImage.alt} />

    {/* Self-hosted (astro.config.mjs → fonts). Every page sets text in the
        upright styles of both, so those load first; the italics load only
        where a page uses them. */}
    <Font cssVariable="--font-next" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-mono-face" preload={[{ style: 'normal' }]} />

    {/* The .ico claims 32×32 so Chrome picks the SVG over it. */}
    <link rel="icon" href={withBase(icoIcon.path)} sizes="32x32" />
    <link rel="icon" href={withBase(svgIcon)} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase(appleTouchIcon.path)} />
    <link rel="manifest" href={withBase('/manifest.webmanifest')} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

    <noscript>
      <style>
        /* Entrance motion is a progressive enhancement. Without scripting the
           page is served as-is: nothing waits to be revealed. */
        [data-reveal] {
          animation: none !important;
        }
      </style>
    </noscript>

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <main id="main" class:list={[mainClass]}>
      <slot />
    </main>

    {
      footer && (
        <Footer>
          <slot name="footer" />
        </Footer>
      )
    }

    {/* `hidden` keeps it out of layout and the accessibility tree; browsers
        still fetch a hidden image, and that fetch is the count. */}
    {countVisits && <img hidden alt="" src={counterSrc} width="1" height="1" />}

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

<style>
  /* Parked off-canvas with a transform rather than `top` so revealing it is a
     compositor-only move. Resets the site's link look: this is a control. */

  .skip-link {
    position: absolute;
    left: var(--space-sm);
    top: var(--space-sm);
    z-index: var(--z-overlay);
    font: inherit;
    letter-spacing: normal;
    text-transform: none;
    text-decoration: none;
    text-underline-offset: auto;
    background: var(--ink);
    color: var(--paper);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    transform: translateY(calc(-100% - var(--space-md)));
    transition: transform var(--dur) var(--ease);
  }

  .skip-link:focus {
    transform: none;
  }

  @media print {
    .skip-link {
      display: none !important;
    }
  }
</style>
