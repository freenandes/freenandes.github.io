---
/** A case study. Body copy lives in `src/content/projects/<slug>.mdx`; locked
    projects add the passphrase gate below the public teaser. One enlarged
    view serves every screenshot and video on the page. The footer opens with
    the mini-map, linking every page on the map. A published locked project
    fails the build until its ciphertext is in `public/locked/`. */

import { existsSync, readFileSync } from 'node:fs';
import path from 'node:path';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Lightbox from '../components/Lightbox.astro';
import MiniMap from '../components/MiniMap.astro';
import PageNav from '../components/PageNav.astro';
import PasswordGate from '../components/PasswordGate.astro';
import { getProjects } from '../lib/projects';
import { withBase } from '../lib/base';
import { site } from '../site.config';

export async function getStaticPaths() {
  const projects = await getProjects();
  // Case studies share the root with the other pages, and a page file wins over
  // this route, so a project named like one would silently never be built.
  const pages = Object.keys(import.meta.glob('./*.{astro,ts}')).map((file) =>
    file.replace(/^\.\//, '').replace(/\.(astro|ts)$/, '')
  );
  for (const { id } of projects) {
    if (pages.includes(id)) {
      throw new Error(`src/content/projects/${id}.mdx: "/${id}/" is already a page. Rename the file.`);
    }
  }
  /** Why `public/locked/<slug>.json` can't be decrypted, or nothing if it can. */
  function lockedPayloadProblem(slug: string): string | undefined {
    const file = path.resolve('public', 'locked', `${slug}.json`);
    if (!existsSync(file)) return `public/locked/${slug}.json doesn't exist.`;
    try {
      const payload = JSON.parse(readFileSync(file, 'utf8'));
      const fields = ['salt', 'iv', 'ct'].every((key) => typeof payload[key] === 'string');
      if (fields && typeof payload.iter === 'number') return undefined;
    } catch {
      // Falls through to the same answer as a payload missing its fields.
    }
    return `public/locked/${slug}.json isn't a payload \`npm run encrypt\` wrote.`;
  }
  // CI never sees the plaintext or passwords, so a locked project's committed
  // ciphertext is all the live gate has. Without it, the right passphrase is
  // refused. Dev only warns, so a teaser can be drafted before it's encrypted.
  for (const { id, data } of projects) {
    if (!data.locked) continue;
    const problem = lockedPayloadProblem(id);
    if (!problem) continue;
    const message = `src/content/projects/${id}.mdx is locked, but ${problem} Run \`npm run encrypt\` and commit public/locked/${id}.json.`;
    if (import.meta.env.PROD) throw new Error(message);
    console.warn(message);
  }
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const client = data.client && data.client !== data.title ? data.client : undefined;
const heading = client ? `${data.title} at ${client}` : data.title;

const origin = Astro.site ?? Astro.url;
const abs = (path: string) => new URL(withBase(path), origin).toString();
const pageUrl = new URL(Astro.url.pathname, origin).toString();
const personId = `${abs('/')}#person`;

const jsonLd = [
  {
    '@type': 'CreativeWork',
    '@id': `${pageUrl}#work`,
    name: data.title,
    headline: data.title,
    description: data.description,
    url: pageUrl,
    datePublished: data.date.iso,
    inLanguage: site.locale,
    isPartOf: { '@id': `${abs('/')}#website` },
    author: { '@id': personId },
    creator: { '@id': personId },
    ...(data.tags.length ? { keywords: data.tags.join(', ') } : {}),
    ...(data.client ? { sourceOrganization: { '@type': 'Organization', name: data.client } } : {}),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Map', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: data.title, item: pageUrl },
    ],
  },
];
---

<Base title={data.title} description={data.description} ogType="article" jsonLd={jsonLd}>
  <article>
    <PageNav>
      <li><a href={withBase('/')}>Back to map</a></li>
    </PageNav>

    <header data-reveal>
      <h1>{heading}</h1>
      <p>{data.description}</p>
      <ul class="meta-row" role="list">
        {data.role && <li class="meta">{data.role}</li>}
        <li class="meta"><time datetime={data.date.iso}>{data.date.label}</time></li>
        {data.tags.map((tag) => <li class="meta">{tag}</li>)}
      </ul>
    </header>

    <div class="prose" data-reveal style="--reveal-step: 1">
      <Content />
    </div>

    {data.locked && <PasswordGate slug={entry.id} />}

    {
      data.links.length > 0 && (
        <ul role="list" data-reveal style="--reveal-step: 3">
          {data.links.map((link) => (
            <li>
              <a href={link.href} target="_blank">{link.label}</a>
            </li>
          ))}
        </ul>
      )
    }
  </article>

  <Lightbox />

  <MiniMap slot="footer" />
</Base>

<style>
  h1 {
    margin-block-end: var(--space-sm);
  }

  header ul {
    margin-block: var(--space-lg);
  }

  article > ul {
    margin-block-start: var(--space-xl);
  }
</style>
