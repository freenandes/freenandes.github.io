---
/** Home: an interactive map of the site. Markers, copy and connections are all
    in `src/diagram.config.ts`, except that a case study's label, tags and link
    come from its project (`src/lib/diagram.ts`); the physics that places them
    is in `src/scripts/nav-diagram.ts`. */

import { basename } from 'node:path';
import type { ImageMetadata } from 'astro';
import type { SvgComponent } from 'astro/types';
import { Image } from 'astro:assets';
import Ruler from '../assets/ruler.svg';
import Base from '../layouts/Base.astro';
import type { DiagramNode, NodeKind } from '../diagram.config';
import { withBase } from '../lib/base';
import { getDiagramNodes, polygon } from '../lib/diagram';
import { site } from '../site.config';
import portrait from '../assets/sticker.png';

const nodes = await getDiagramNodes();

// Every drawing in this folder lands on the map's texture, with nothing else to
// wire up. Each is drawn in `currentColor`, so `.decor` below colours them all,
// and each has its own width knob below, named after its file.
const decorations = Object.entries(
  import.meta.glob<SvgComponent & ImageMetadata>('../assets/decor/*.svg', {
    eager: true,
    import: 'default',
  }),
).map(([path, Drawing]) => ({ Drawing, name: basename(path, '.svg') }));

// Drawings that read as the portrait's speech balloon: the map script lands
// them beside the sticker, at a new spot on each load.
const balloons = new Set(['proposta-de-valor']);

// A marker's preview is the image in this folder named after its id, with its
// alt text in diagram.config.ts. One without the other is a mistake, so the
// build stops instead of shipping a preview with no alt, or none at all.
const previews = new Map(
  Object.entries(
    import.meta.glob<ImageMetadata>('../assets/previews/*.{jpg,jpeg,png,webp}', {
      eager: true,
      import: 'default',
    }),
  ).map(([path, image]) => [basename(path).replace(/\.[^.]+$/, ''), image]),
);
for (const id of previews.keys()) {
  const node = nodes.find((n) => n.id === id);
  if (!node?.preview) {
    throw new Error(
      `src/assets/previews/${id}: no marker in diagram.config.ts has that id and a \`preview\` alt text.`,
    );
  }
}
for (const node of nodes) {
  if (node.preview && !previews.has(node.id)) {
    throw new Error(
      `diagram.config.ts: "${node.id}" has a \`preview\` alt text but no image in src/assets/previews/.`,
    );
  }
}
const withPreview = nodes.filter((n) => previews.has(n.id));

// The preview is served at these widths; the card and the floating copy share
// them, so a browser that shows both fetches one file.
const previewWidths = [480, 800, 1200, 1680];

/** Circle just big enough to carry `label` once around, with a gap. */
function ring(label: string) {
  const FONT = 12;
  const advance = FONT * 0.725;
  const textLength = Math.max(label.length * advance, 90);
  const r = (textLength + 4 * advance) / (2 * Math.PI);
  const size = Math.round(2 * (r + FONT * 1.25));
  const c = size / 2;
  return {
    textLength: textLength.toFixed(2),
    size,
    d: `M ${c} ${(c - r).toFixed(2)} a ${r.toFixed(2)} ${r.toFixed(2)} 0 1 1 0 ${(2 * r).toFixed(2)} a ${r.toFixed(2)} ${r.toFixed(2)} 0 1 1 0 ${(-2 * r).toFixed(2)}`,
  };
}

// Two kinds of marker look different from the rest — the name at the centre of
// the map, and the decorative rings. Add a kind here to give it its own class.
const variant = (node: DiagramNode) =>
  node.kind === 'identity' || node.kind === 'floating' ? `node--${node.kind}` : undefined;

// Markers render in three runs so the case studies can be announced as a set.
// The wrappers are `display: contents` — they group, they don't lay out.
const pick = (...kinds: NodeKind[]) => nodes.filter((n) => kinds.includes(n.kind));
const runs: { label?: string; nodes: DiagramNode[] }[] = [
  { nodes: pick('identity', 'about', 'contact') },
  { label: 'Selected projects', nodes: pick('project') },
  { nodes: pick('floating') },
];

// The map's destinations as plain links, for the fallback below: every marker
// with a page, then the socials that work without the script (the email
// address needs it to be decoded).
const fallbackLinks = [
  ...nodes.flatMap((node) =>
    node.link
      ? [
          {
            label: node.label,
            href: node.link.external ? node.link.href : withBase(node.link.href),
            rel: undefined,
          },
        ]
      : [],
  ),
  ...site.socials.flatMap((s) => (s.href ? [{ label: s.label, href: s.href, rel: 'me' }] : [])),
];
---

<Base footer={false} mainClass="home">
  <nav
    class="diagram"
    aria-label={`Site map — ${site.name}`}
    style={`--topo-pattern: url('${withBase('/topo-low.svg')}')`}
  >
    <svg class="links" aria-hidden="true" focusable="false"></svg>
    {
      runs.map((run) => (
        <div class="run" role={run.label ? 'group' : undefined} aria-label={run.label}>
          {run.nodes.map((node) => {
            const Heading = node.kind === 'identity' ? 'h1' : 'h2';
            const panelId = `panel-${node.id}`;
            const circle = node.kind === 'floating' ? ring(node.label) : null;
            return (
              <div class:list={['node', variant(node)]} data-id={node.id}>
                {circle ? (
                  <>
                    {/* The spinning text is for the eye. Screen readers get
                        the same words as a plain line, which reads more
                        reliably than text set along a path. */}
                    <svg
                      style={`--ring-start: ${node.ringStart ?? 0}deg`}
                      viewBox={`0 0 ${circle.size} ${circle.size}`}
                      width={circle.size}
                      height={circle.size}
                      aria-hidden="true"
                      focusable="false"
                    >
                      <defs>
                        <path id={`ring-${node.id}`} d={circle.d} fill="none" />
                      </defs>
                      <text>
                        <textPath
                          href={`#ring-${node.id}`}
                          startOffset="0"
                          textLength={circle.textLength}
                          lengthAdjust="spacingAndGlyphs"
                        >
                          {node.label}
                        </textPath>
                      </text>
                    </svg>
                    <p class="visually-hidden">{node.label}</p>
                  </>
                ) : (
                  <Heading>
                    {/* The name at the centre opens no card: a click
                        reshuffles the map, which its tooltip says. */}
                    <button
                      type="button"
                      title={node.kind === 'identity' ? 'Reshuffle the map' : undefined}
                      aria-expanded={node.kind === 'identity' ? undefined : 'false'}
                      aria-controls={node.kind === 'identity' ? undefined : panelId}
                    >
                      {/* Sized for a page whose stylesheet hasn't loaded. */}
                      <svg
                        viewBox="0 0 20 20"
                        width="16"
                        height="16"
                        aria-hidden="true"
                        focusable="false"
                      >
                        <polygon points={polygon(node.shape)} />
                      </svg>
                      <span>{node.label}</span>
                      {node.subLabel && <span>{node.subLabel}</span>}
                    </button>
                  </Heading>
                )}

                {node.kind !== 'identity' && !circle && (
                  <div class="panel" id={panelId} role="group" aria-label={node.label}>
                    {/* Shown only when the card opens as a popup (touch
                        screens); a desktop shows it beside the marker on
                        hover instead (`.preview`, below). */}
                    {previews.has(node.id) && (
                      <Image
                        src={previews.get(node.id)!}
                        alt={node.preview ?? ''}
                        widths={previewWidths}
                        sizes="min(100vw, 28rem)"
                        format="webp"
                        loading="lazy"
                        decoding="async"
                        draggable="false"
                      />
                    )}
                    {node.tagline && <p class="lead">{node.tagline}</p>}
                    {node.lines?.map((line) => <p>{line}</p>)}
                    {!!node.tags?.length && (
                      <ul class="meta-row" role="list">
                        {node.tags.map((tag) => <li class="meta">{tag}</li>)}
                      </ul>
                    )}
                    {node.kind === 'contact' && (
                      <ul role="list">
                        {site.socials.map((s) => (
                          <li>
                            <a
                              href={s.href}
                              data-email={s.token}
                              rel={s.href?.startsWith('http') ? 'me' : undefined}
                            >
                              {s.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                    {node.link && (
                      <a
                        href={node.link.external ? node.link.href : withBase(node.link.href)}
                        target={node.link.external ? '_blank' : undefined}
                      >
                        {node.link.label}
                      </a>
                    )}
                  </div>
                )}
              </div>
            );
          })}
        </div>
      ))
    }
    {/* If the map never starts (its script failed to load or threw), its
        markers stay hidden, so this plain list of where it leads takes their
        place after a delay. A working map removes the wait before it ends. */}
    <div class="fallback">
      <p>The map couldn’t load. Here’s where it leads:</p>
      <ul>
        {
          fallbackLinks.map((link) => (
            <li>
              <a href={link.href} rel={link.rel}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    {/* The drawings and the ruler come after the markers, so a page that paints
        before its stylesheet shows the map's content first. Their zero size
        holds until the stylesheet gives them theirs, so they can't flash in
        unstyled at full width. */}
    {
      decorations.map(({ Drawing, name }) => (
        <Drawing
          class="decor"
          width="0"
          height="0"
          style={`--decor-frame: ${Drawing.width}; --decor-width: var(--decor-${name})`}
          data-balloon={balloons.has(name) ? '' : undefined}
          aria-hidden="true"
          focusable="false"
        />
      ))
    }
    <Ruler
      class="ruler"
      width="0"
      height="0"
      preserveAspectRatio="xMaxYMax meet"
      aria-hidden="true"
      focusable="false"
    />
    {/* The portrait sticker sits on the drawings, under the map, so it comes
        last among them. Its width and height give a page with no stylesheet
        a small picture, not a full-size one. */}
    <Image
      class="sticker"
      src={portrait}
      alt={`Sticker of ${site.name} in a training suit and a cap that says "Run"`}
      width={160}
      densities={[1, 2, 3]}
      format="webp"
      loading="eager"
      decoding="async"
      draggable="false"
    />
    {/* Each marker's preview floats over everything while the pointer is on
        the marker, so it's the last thing in the map. It only entices: the
        card says the same in words, so it's hidden from assistive tech. */}
    {
      withPreview.map((node) => (
        <Image
          class="preview"
          data-preview-for={node.id}
          src={previews.get(node.id)!}
          alt=""
          widths={previewWidths}
          sizes="26rem"
          format="webp"
          loading="lazy"
          decoding="async"
          draggable="false"
          aria-hidden="true"
        />
      ))
    }
  </nav>

  {/* Inside the layout, so it lands in the <body>, not after </html>. */}
  <script>
    import { initDiagram } from '../scripts/nav-diagram';

    const root = document.querySelector<HTMLElement>('.diagram');
    if (root) {
      try {
        initDiagram(root);
      } catch (error) {
        // Swap in the plain list of links now rather than after the delay
        // (see "Fallback" in the styles), and still report the error.
        root.dataset.failed = '';
        throw error;
      }
    }
  </script>

  {/* Without scripting, the map is laid out as a plain list that still fills
      the screen, so the texture does too. It goes in the <head>, the one place
      a <noscript> may hold styles. */}
  <noscript slot="head">
    <style>
      .diagram {
        display: flex;
        flex-direction: column;
        height: auto !important;
        min-height: 100svh !important;
        padding: var(--space-md) !important;
      }

      .links {
        display: none !important;
      }

      .node {
        position: static !important;
        transform: none !important;
        display: flex !important;
        flex-direction: column;
        align-items: center;
        width: 100%;
        max-width: 40rem;
        margin-inline: auto;
        margin-block-end: var(--space-lg);
      }

      .panel {
        position: static !important;
        opacity: 1 !important;
        visibility: visible !important;
        translate: none !important;
        pointer-events: auto !important;
        margin-block-start: var(--space-sm);
      }

      /* The entrance is held until the script has placed the map, so without
         scripting there is nothing to wait for. */

      .node,
      .node button svg {
        animation: none !important;
      }

      /* The list above already reads like the fallback, so it stays out. */

      .run {
        animation: none !important;
      }

      .fallback {
        display: none !important;
      }
    </style>
  </noscript>
</Base>

<style>
  /* --- Knobs and canvas ------------------------------------------------ */

  /* The custom properties are this page's own values, in one place. Shared
     ones (colour, type, space, motion) are in tokens.css; spacing, physics and
     entrance timing of the layout are in KNOBS at the top of
     src/scripts/nav-diagram.ts. */

  .diagram {
    --topo-size: 150rem; /* width of one tile of the contour texture */
    --topo-opacity: 0.1;
    --marker-size: 1rem;
    --marker-size-identity: 1.25rem; /* the name at the centre */
    --link-width: 1.375; /* connector stroke */
    --card-width: 20rem; /* widest a card gets (never more than 90vw) */
    --ring-turn: 30s; /* one full turn of a floating ring */

    /* Each drawing's width, named after its file in src/assets/decor/, and
       its width on a large screen (from 64rem wide, below). */
    --decor-flag: 4rem;
    --decor-flag-wide: 5rem;
    --decor-compass: 14rem;
    --decor-compass-wide: 20rem;
    --decor-kraken: 12rem;
    --decor-kraken-wide: 16rem;
    --decor-proposta-de-valor: 14rem;
    --decor-proposta-de-valor-wide: 20rem;

    /* The size of a drawing with no width above, per unit of its viewBox, and
       on a large screen. */
    --decor-scale: calc(4rem / 400);
    --decor-scale-wide: calc(5rem / 400);

    --ruler-height: 2.25rem;

    /* How long the map may take to start before its markers give way to a
       plain list of its links (see "Fallback", below). */
    --fallback-delay: 4s;

    /* A marker's preview: the screen that floats beside it while a desktop
       pointer is on it, above everything on the map, and how much of the map
       shows through it. */
    --preview-width: clamp(18rem, 26vw, 26rem);
    --preview-opacity: 0.9;

    /* On a touch screen a card opens as a popup in the middle of the screen
       instead, this wide at most, with at least this much room around it to
       tap and close it. */
    --popup-width: 28rem;
    --popup-gap: 1.5rem;

    /* The portrait sticker in the top left corner. Each page load drops it
       somewhere in a small area there and gives it a slightly different
       tilt; the script picks once, so it never moves after that. */
    --sticker-width: clamp(7.5rem, 22vw, 10rem);

    /* Where the area starts: the least space kept from the canvas's top and
       left edges. It grows with the screen, between its min and max. */
    --sticker-top: clamp(var(--space-md), 3vw, var(--space-xl));
    --sticker-left: clamp(var(--space-md), 3vw, var(--space-xl));

    /* How far past that start it may land, rightwards and downwards. Zero
       pins it to the start. */
    --sticker-roam-x: clamp(0rem, 6vw, 6rem);
    --sticker-roam-y: clamp(0rem, 3vw, 3rem);

    /* Its tilt: the middle of the range, and how far either side it may go.
       Negative leans it left. */
    --sticker-tilt: -2deg;
    --sticker-tilt-range: 5deg;

    /* Its drop shadow. */
    --sticker-shadow-x: 0;
    --sticker-shadow-y: 0.125rem;
    --sticker-shadow-blur: 0.25rem;
    --sticker-shadow-color: rgb(0 0 0 / 33%);

    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 34rem;
    overflow: hidden;
    touch-action: pan-y;
  }

  /* A large screen swaps in each drawing's wide size. A new drawing with a
     wide knob needs its line here too. */

  @media (width >= 64rem) {
    .diagram {
      --decor-flag: var(--decor-flag-wide);
      --decor-compass: var(--decor-compass-wide);
      --decor-kraken: var(--decor-kraken-wide);
      --decor-proposta-de-valor: var(--decor-proposta-de-valor-wide);
      --decor-scale: var(--decor-scale-wide);
    }
  }

  /* Full-bleed: the map opts out of the reading column every other page has
     (global.css → Layout). */

  :global(main.home) {
    max-width: none;
    min-height: 100svh;
    padding-inline: 0;
    isolation: isolate;
  }

  /* Contour texture behind the map. `--topo-pattern` is set on the element so
     the asset path can follow the site's base path. */

  .diagram::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image: var(--topo-pattern);
    background-repeat: repeat;
    background-position: top center;
    background-size: var(--topo-size) auto;
    opacity: var(--topo-opacity);
  }

  @media print {
    .diagram::before {
      display: none;
    }
  }

  /* The drawings from src/assets/decor/ share the texture's layer and follow it
     in the tree, so they sit on it and under everything else, though they come
     after the markers. Their size here overrides the zero the markup gives them
     (the height follows the width through the viewBox). The script gives
     each a random spot clear of the map once the map has come to rest, and it
     stays there. One with no room stays hidden. */

  .decor {
    position: absolute;
    top: 0;
    left: 0;
    z-index: -1;
    width: var(--decor-width, calc(var(--decor-frame) * var(--decor-scale)));
    height: auto;
    color: var(--ink-decor);
    pointer-events: none;
    translate: var(--decor-x, 0) var(--decor-y, 0);
    opacity: 0;
  }

  .decor[data-placed] {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .decor[data-placed] {
      animation: node-in var(--dur) var(--ease);
    }
  }

  /* The ruler is on the same layer, but it's the map's scale, so it keeps to its
     corner and the script only keeps the drawings off it. A narrow screen shrinks
     it to fit, against the same corner. */

  .ruler {
    position: absolute;
    right: var(--space-md);
    bottom: var(--space-md);
    z-index: -1;
    width: auto;
    height: var(--ruler-height);
    max-width: calc(100% - 2 * var(--space-md));
    color: var(--ink-decor);
    pointer-events: none;
  }

  /* The portrait sticker keeps to its corner, on the drawings' layer and after
     them in the tree, so it covers them and nothing else. The
     script keeps markers, rings and drawings off it, so it never moves with
     the map. It fades in with the markers. */

  .sticker {
    position: absolute;

    /* The script sets `--sticker-rx` and `--sticker-ry` (0 to 1) and
       `--sticker-rt` (-1 to 1) once per page load. */
    top: calc(var(--sticker-top) + var(--sticker-ry, 0) * var(--sticker-roam-y));
    left: calc(var(--sticker-left) + var(--sticker-rx, 0) * var(--sticker-roam-x));
    z-index: -1;
    width: var(--sticker-width);
    height: auto;
    rotate: calc(var(--sticker-tilt) + var(--sticker-rt, 0) * var(--sticker-tilt-range));
    filter: drop-shadow(
      var(--sticker-shadow-x) var(--sticker-shadow-y) var(--sticker-shadow-blur)
        var(--sticker-shadow-color)
    );
    pointer-events: none;
    -webkit-user-select: none;
    user-select: none;
  }

  /* On a phone the corner is tight, so the sticker slips past the canvas's
     left edge and the viewport crops its shoulder, never its face. It roams
     less, so it can't wander into the map. */

  @media (width < 30rem) {
    .diagram {
      --sticker-top: var(--space-lg);
      --sticker-left: calc(-0.22 * var(--sticker-width));
      --sticker-roam-x: var(--space-md);
      --sticker-roam-y: var(--space-sm);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .sticker {
      animation: node-in var(--dur-slow) var(--ease) backwards paused;
    }

    .diagram.is-mounted .sticker {
      animation-play-state: running;
    }
  }

  .links {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  /* Connectors are drawn by the script, so they are outside this scope. */

  .links :global(.link-line) {
    fill: none;
    stroke: var(--ink-3);
    stroke-width: var(--link-width);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Grouping only: no box, so markers still position against `.diagram`. */

  .run {
    display: contents;
  }

  /* --- Entrance --------------------------------------------------------- */

  /* The map draws itself once: markers land along the chain, then each
     connector is traced between the two it joins. The script sets the
     per-element delay and releases the hold only after it has solved the
     layout, so nothing animates in from a spot it is about to leave. */

  @media (prefers-reduced-motion: no-preference) {
    .node {
      animation: node-in var(--dur) var(--ease) var(--enter-delay, 0ms) backwards paused;
    }

    .node button svg {
      animation: dot-in var(--dur) var(--ease) var(--enter-delay, 0ms) backwards paused;
    }

    .links :global(.link-line) {
      animation: edge-draw var(--dur-slow) var(--ease) var(--enter-delay, 0ms) backwards paused;
    }

    .diagram.is-mounted .node,
    .diagram.is-mounted .node button svg,
    .diagram.is-mounted .links :global(.link-line) {
      animation-play-state: running;
    }
  }

  @keyframes node-in {
    from {
      opacity: 0;
    }
  }

  @keyframes dot-in {
    from {
      transform: scale(0.7);
    }
  }

  /* `pathLength="1"` (set by the script) makes these normalised units, so the
     trace holds up while the simulation is still nudging the endpoints. */

  @keyframes edge-draw {
    from {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }

    to {
      stroke-dasharray: 1;
      stroke-dashoffset: 0;
    }
  }

  /* --- Fallback --------------------------------------------------------- */

  /* The markers wait for the script, so a map that never starts would leave
     nothing to click. Unless the script has mounted the map by
     `--fallback-delay`, the markers are hidden and a plain list of their links
     shows instead; if the script fails outright, it swaps them at once.
     Hidden, the list neither shows, takes a click nor reaches a screen
     reader. */

  .fallback {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-content: center;
    padding: var(--space-md);
    visibility: hidden;
  }

  .diagram:not(.is-mounted) .run {
    animation: fallback-hide 0s var(--fallback-delay) forwards;
  }

  .diagram:not(.is-mounted) .fallback {
    animation: fallback-show 0s var(--fallback-delay) forwards;
  }

  .diagram:not(.is-mounted)[data-failed] :is(.run, .fallback) {
    animation-delay: 0s;
  }

  @keyframes fallback-hide {
    to {
      visibility: hidden;
    }
  }

  @keyframes fallback-show {
    to {
      visibility: visible;
    }
  }

  /* --- Markers ---------------------------------------------------------- */

  .node {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    will-change: transform;
  }

  .node:has(button[aria-expanded='true']),
  .node.is-dragging {
    z-index: 6;
  }

  /* The headings give the page a real outline without changing the look: they
     wrap the existing button and inherit all typography from it. */

  h1,
  h2 {
    display: inline-flex;
    font: inherit;
    letter-spacing: inherit;
    text-wrap: nowrap;
