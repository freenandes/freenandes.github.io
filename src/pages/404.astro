---
/** Served at every address that doesn't exist. Two readers land here: someone
    browsing the portfolio, led back to its map, and someone after the UX audit
    page who mistyped its address and has never seen the map. The script below
    tells them apart by the address and sends the second straight on. */

import Base from '../layouts/Base.astro';
import { withBase } from '../lib/base';
---

<Base
  title="Page not found"
  description="The page you were looking for doesn't exist or has moved."
  noindex
>
  <section data-for="portfolio">
    <h1 class="meta" data-reveal>Page not found</h1>
    <h2 data-reveal style="--reveal-step: 1">You've wandered off the map</h2>
    <p data-reveal style="--reveal-step: 2">
      The page you were looking for doesn't exist, or it has moved. Head back to the map and pick another page to continue.
    </p>
    <ul role="list" data-reveal style="--reveal-step: 3">
      <li><a href={withBase('/')}>Back to map</a></li>
    </ul>
  </section>

  {/* Shown only while the script forwards a mistyped UX audit address, in case
      the next page is slow to come. */}
  <section data-for="ux-audit" hidden>
    <h1 class="meta" data-reveal>Page not found</h1>
    <h2 data-reveal style="--reveal-step: 1">Looking for the UX audit?</h2>
    <p data-reveal style="--reveal-step: 2">That address doesn't exist, so I'm taking you to the UX audit page.</p>
    <ul role="list" data-reveal style="--reveal-step: 3">
      <li><a href={withBase('/services/ux-audit/')}>Go to the UX audit</a></li>
    </ul>
  </section>

  <script>
    // GitHub Pages paths are case-sensitive, so /Services/ misses as surely as
    // /services/ux-audt. Any address that, lowercased, starts with /service
    // (which covers /services) or /servicos, or mentions ux-audit, uxaudit or
    // ux_audit, is someone after the UX audit page: show them the note meant
    // for them and forward them, leaving this miss out of the back button.
    // Every other address keeps the portfolio's note and its way back to the map.
    const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
    const path = location.pathname.slice(base.length).toLowerCase();
    const wantsAudit = /^\/servic(e|os)/.test(path) || /ux[-_]?audit/.test(path);

    if (wantsAudit) {
      for (const section of document.querySelectorAll<HTMLElement>('[data-for]')) {
        section.hidden = section.dataset.for !== 'ux-audit';
      }
      location.replace(`${base}/services/ux-audit/`);
    }
  </script>
</Base>

<style>
  /* Short page: hold it near the middle of the viewport rather than the top. */

  section {
    min-height: 50svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  h2 {
    margin-block: var(--space-sm);
  }

  ul {
    margin-block-start: var(--space-md);
  }
</style>
