---
/** The mini-map that opens the footer of About and every case study: the home
    map's pages pulled into one straight, static line, which also stands in for
    the footer's rule. Each marker links to its page, and the page it's on is
    marked. The markers and their order are the map's own
    (`src/diagram.config.ts`, through `src/lib/diagram.ts`). Where the line
    runs across, it stays pinned to the foot of the window, on paper under a
    rule, until the reader reaches its own place above the footer. */

import { diagramChain, type DiagramNode } from '../diagram.config';
import { bare, withBase } from '../lib/base';
import { getDiagramNodes, polygon } from '../lib/diagram';

/** The page a marker stands for. The name at the centre is the map itself, which
    the pinned page nav always links to. The contact card has no page (the
    footer carries its links), the side project's links lead off the site,
    and the floating rings are decoration. */
function pageOf(node: DiagramNode): string | undefined {
  if (node.kind !== 'about' && node.kind !== 'project') return undefined;
  return node.links?.find((link) => !link.external)?.href;
}

// Stops follow the chain, closing up over the markers it skips. A page the
// chain leaves out comes last.
const rank = (id: string) => {
  const i = diagramChain.indexOf(id);
  return i < 0 ? diagramChain.length : i;
};
const here = bare(Astro.url.pathname);
const stops = (await getDiagramNodes())
  .flatMap((node) => {
    const page = pageOf(node);
    return page ? [{ node, href: withBase(page) }] : [];
  })
  .sort((a, b) => rank(a.node.id) - rank(b.node.id))
  .map(({ node, href }) => ({
    label: node.label,
    shape: node.shape,
    href,
    current: bare(href) === here,
  }));
---

{/* A line needs two ends. With fewer stops this renders nothing, and the
    footer keeps its rule. */}
{
  stops.length > 1 && (
    <nav aria-label="Pages" data-reveal>
      <ol role="list" style={`--stops: ${stops.length}`}>
        {stops.map(({ label, shape, href, current }) => (
          <li>
            <a href={href} aria-current={current ? 'page' : undefined}>
              {/* Sized for a page whose stylesheet hasn't loaded. */}
              <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false">
                <polygon points={polygon(shape)} />
              </svg>
              <span>{label}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
{/* Marks where the line rests, just under it, so the script can tell when it
    is pinned above that place. It has no size, so it takes no room. */}
{stops.length > 1 && <div data-mini-map-end></div>}

<script>
  const end = document.querySelector('[data-mini-map-end]');
  const nav = end?.previousElementSibling;

  // Its resting place is below the window while the line is pinned. The
  // pinned gap (`--pinned-gap`, the bar's bottom padding) still hangs below
  // that place, so the line comes to rest only once the place has risen
  // that far above the window's foot.
  if (nav && end) {
    const gap = Number.parseFloat(getComputedStyle(nav).paddingBlockEnd) || 0;
    const observer = new IntersectionObserver(
      ([entry]) => {
        nav.classList.toggle('is-pinned', !entry.isIntersecting && entry.boundingClientRect.top > 0);
      },
      { rootMargin: `0px 0px ${-gap}px 0px` },
    );
    observer.observe(end);
  }
</script>

<style>
  /* The custom properties are this component's own values, in one place. The
     marker starts from the home map's (the knobs at the top of index.astro's
     <style>); the connector is drawn like the site's dividers, since it stands
     in for the footer's rule. The width where the line turns from a column
     into a row is the container query further down. */

  nav {
    --marker-size: 1rem;
    --link-width: 1px; /* connector stroke, as thick as a divider */
    --link-color: var(--ink-3); /* connector colour */
    --stop-pad: 0.75rem; /* air around a stop, inside its hit area */
    --stack-pad: 1.5rem; /* air above and below a stop in the column */
    --label-gap: var(--space-md); /* least room between two labels in the row */
    --pinned-gap: var(--space-md); /* while pinned, extra room under the labels, down to the window's foot */

    container-type: inline-size;
    padding-block-start: var(--space-sm);
  }

  /* An <ol> because the stops have an order, and so the site's row styling
     for ul[role="list"] stays out of it. The role keeps Safari announcing it as
     a list once the numbers are gone. `isolation` keeps the connector's
     z-index inside the list. */

  ol {
    position: relative;
    display: grid;
    grid-auto-rows: 1fr;
    padding: 0;
    list-style: none;
    isolation: isolate;
  }

  /* The connector: one line from the first marker's centre to the last,
     behind the markers' paper fill. Rows are all one height, so the end
     markers sit half a row in from either end. */

  ol::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: calc(50% / var(--stops)) auto calc(50% / var(--stops))
      calc((var(--marker-size) - var(--link-width)) / 2);
    width: var(--link-width);
    background: var(--link-color);
  }

  li {
    position: relative;
    display: flex;
  }

  /* A stop: the marker, then its label. Resets the site's link look, as the
     map's markers aren't styled as links either. The page you're on stays a
     link, marked with aria-current, so a screen reader moving through the
     links still hears which one is the current page. */

  a {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    min-width: 0;
    padding: var(--stack-pad) var(--stop-pad) var(--stack-pad) 0;
    font: inherit;
    letter-spacing: inherit;
    text-transform: none;
    text-decoration: none;
    color: var(--ink-2);
  }

  a:hover,
  a:focus-visible,
  a[aria-current='page'] {
    color: var(--ink);
  }

  svg {
    flex: none;
    width: var(--marker-size);
    height: var(--marker-size);
    overflow: visible;
    transition: transform var(--dur-fast) var(--ease);
  }

  polygon {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.75;
    vector-effect: non-scaling-stroke;
    transition: fill var(--dur-fast) var(--ease), stroke var(--dur-fast) var(--ease);
  }

  /* Pointing at a stop lights it the way the map lights a marker. The page
     you're on is filled in ink instead, and stays that way: accent is for
     where you can go. */

  a:not([aria-current]):hover svg,
  a:not([aria-current]):focus-visible svg {
    transform: scale(1.25);
  }

  a:not([aria-current]):hover polygon,
  a:not([aria-current]):focus-visible polygon {
    fill: var(--accent);
    stroke: var(--accent-ink);
  }

  a[aria-current='page'] polygon {
    fill: var(--ink);
  }

  span {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    white-space: pre-line;
  }

  /* With room for it, the line runs left to right, as the map does on a wide
     screen. 30rem fits five stops; raise it if the map grows past that. */

  @container (width >= 30rem) {
    /* Each stop is as wide as its label, and the labels spread across the
       text with equal gaps, from one edge to the other. */

    ol {
      display: flex;
      justify-content: space-between;
      column-gap: var(--label-gap);
    }

    a {
      flex-direction: column;
      gap: var(--space-xs);
      padding-block: var(--stop-pad);
      padding-inline: 0;
      text-align: center;
    }

    span {
      text-wrap: balance;
    }

    /* Stops are as wide as their labels, so the line can't be measured from
       them: it runs through the markers' middle from edge to edge, and the end
       stops cover the stretch beyond their markers with paper, the way the
       map's labels sit on paper over its connectors. */

    ol::before {
      inset: calc(var(--stop-pad) + (var(--marker-size) - var(--link-width)) / 2) 0 auto;
      width: auto;
      height: var(--link-width);
    }

    li:first-child::before,
    li:last-child::after {
      content: '';
      position: absolute;
      z-index: -1;
      top: calc(var(--stop-pad) + (var(--marker-size) - var(--link-width)) / 2 - 1px);
      width: 50%;
      height: calc(var(--link-width) + 2px);
      background: var(--paper);
    }

    li:first-child::before {
      left: 0;
    }

    li:last-child::after {
      right: 0;
    }
  }

  /* Pinned. Once the line runs across, it sticks to the foot of the window
     and settles into its place above the footer at the end of the page. It's
     a child of <body> (Base.astro), so it can travel the whole page. A media
     query, since the container can't query itself: the 30rem above, plus
     the two gutters and room for a scrollbar that takes up width. */

  @media (width >= 33rem) {
    /* The pinned gap is padding the margin takes back, so the line rests
       where it always has: at rest, the gap lies over the footer's own top
       padding, and nothing shows in it. */

    nav {
      position: sticky;
      bottom: 0;
      z-index: var(--z-sticky);
      padding-block-end: var(--pinned-gap);
      margin-block-end: calc(-1 * var(--pinned-gap));
    }

    /* While pinned, the page scrolls under a paper plate topped with a
       divider, as it does under the page nav: the shadow carries the paper
       out to the window's edges, and the rule stays on the column. At rest
       the plate fades away, and the line reads as the footer's rule again. */

    nav::before {
      content: '';
      position: absolute;
      inset: 0 var(--gutter);
      z-index: -1;
      background: var(--paper);
      border-block-start: 1px solid var(--line);
      box-shadow: 0 0 0 100vmax var(--paper);
      clip-path: inset(0 -100vmax);
      opacity: 0;
      transition: opacity var(--dur) var(--ease);
    }

    nav.is-pinned::before {
      opacity: 1;
    }

    /* Whatever the keyboard moves to lands clear of the pinned line. */

    :global(html) {
      scroll-padding-block-end: 6rem;
    }
  }

  @media print {
    nav {
      display: none !important;
    }
  }
</style>
