---
/** The footer: availability, contact links and copyright. A page can open it
    with something of its own, through Base's `footer` slot (the case studies'
    mini-map), which then stands in for the rule. */

import { site } from '../site.config';
---

<footer data-reveal>
  <slot />
  <div>
    <p>{site.availability}</p>
    <ul role="list">
      {site.socials.map((s) => (
        <li><a href={s.href} data-email={s.token}>{s.label}</a></li>
      ))}
    </ul>
    <p>© {new Date().getFullYear()} {site.name}</p>
  </div>
</footer>

<style>
  div {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    padding-block: var(--space-lg);
  }

  /* The rule sits on the inner box so it lines up with the text column rather
     than running out into the gutters. It only opens a footer that nothing
     else opens: the mini-map's line takes its place. */

  div:first-child {
    border-block-start: 1px solid var(--line-strong);
  }

  p:last-child {
    font-size: var(--step--1);
    font-weight: var(--weight-medium);
    color: var(--ink-3);
  }
</style>
