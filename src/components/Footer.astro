---
/** The footer: availability, contact links and copyright. Base puts whatever
    a page gives its `footer` slot (the mini-map on About and the case
    studies) right before it, standing in for the rule, and a page adds links
    of its own after the contact links through its `footer-links` slot (the
    `links` slot here). It's never printed (global.css). */

import { site } from '../site.config';

interface Props {
  /** Off drops the rule and the availability line that open the footer. */
  intro?: boolean;
  /** Off drops the rule alone, for a page whose mini-map's line takes its place. */
  rule?: boolean;
}

const { intro = true, rule = true } = Astro.props;
---

<footer class:list={{ ruled: intro && rule }} data-reveal>
  <div>
    {intro && <p>{site.availability}</p>}
    <ul role="list">
      {site.socials.map((s) => (
        <li><a href={s.href} data-email={s.token}>{s.label}</a></li>
      ))}
      <slot name="links" />
    </ul>
    <p>© {new Date().getFullYear()} {site.name}</p>
  </div>
</footer>

<style>
  div {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    padding-block: var(--space-lg);
  }

  /* The rule sits on the inner box so it lines up with the text column rather
     than running out into the gutters. */

  footer.ruled div {
    border-block-start: 1px solid var(--line-strong);
  }

  p:last-child {
    font-size: var(--step--1);
    font-weight: var(--weight-medium);
    color: var(--ink-3);
  }
</style>
