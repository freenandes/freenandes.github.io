---
/** Page navigation. Sits at the top of the article in normal flow, then stays
    pinned to the viewport for the rest of the page, so the way back to the map
    is always in reach. Children are the `<li>` items of the row; the flag at
    its far end is a second link to the map. */
import Flag from '../assets/decor/flag.svg';
import { withBase } from '../lib/base';
---

<div class="sentinel"></div>
<ul class="page-nav" role="list">
  <slot />
  <li>
    {/* The size holds only until the stylesheet loads, so the flag can't paint at full width. */}
    <a href={withBase('/')} aria-label="Back to map">
      <Flag width="28" height="28" aria-hidden="true" />
    </a>
  </li>
</ul>

<style>
  /* Marks the bar's resting place so the script can tell when it is pinned;
     the negative margin keeps it out of the page's vertical rhythm. */

  .sentinel {
    height: 1px;
    margin-block-end: -1px;
  }

  .page-nav {
    /* Knobs: the flag's square frame, and the stroke that gives the drawing
       more weight, in the drawing's own units (306 to the frame), so it keeps
       its proportion at any size. */
    --flag-size: 1.75rem;
    --flag-weight: 4;

    /* Drops the flag to the middle of the links' visible height, from capitals
       to underline, at any size. That middle sits 0.22rem below the row's, and
       the drawing's own middle sits 3% of the frame below the frame's. */
    --flag-shift: calc(0.22rem - 0.03 * var(--flag-size));

    /* Breathing room that exists only while pinned: `top` is a sticky offset,
       so it stays out of the layout when the bar sits in the flow. */
    position: sticky;
    top: var(--space-md);
    z-index: var(--z-sticky);
    margin-block-end: var(--space-lg);
  }

  /* Paper plate so page content scrolls out of sight under the pinned bar. The
     shadow carries the paper out to the window's edges, over whatever hangs
     outside the text column (bullets, wide images), and the clip keeps it to
     the plate's height. A shadow adds nothing to the page's scroll width, and
     the rule stays on the column, like the site's other dividers. */

  .page-nav::before {
    content: '';
    position: absolute;
    inset: calc(-1 * var(--space-md)) 0;
    z-index: -1;
    background: var(--paper);
    border-block-end: 1px solid var(--line);
    box-shadow: 0 0 0 100vmax var(--paper);
    clip-path: inset(0 -100vmax);
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .page-nav.is-pinned::before {
    opacity: 1;
  }

  /* The flag, at the far end of the row. Only this component's own `<li>`
     matches: the slotted ones are in their pages' scope. The negative margins
     take it out of the row's height, so the bar stays as tall as its text. Its
     colour is the link's, hover included, through `currentColor`. */

  li {
    display: flex;
    align-self: center;
    margin-block: calc(var(--flag-size) / -2);
    margin-inline-start: auto;
    translate: 0 var(--flag-shift);
  }

  svg {
    width: var(--flag-size);
    height: var(--flag-size);
    stroke: currentcolor;
    stroke-width: var(--flag-weight);
    stroke-linejoin: round;
  }

  /* Whatever the keyboard moves to lands clear of the pinned bar. */

  :global(html) {
    scroll-padding-block-start: 4rem;
  }

  @media print {
    .sentinel,
    .page-nav {
      display: none !important;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('.page-nav');
  const sentinel = nav?.previousElementSibling;

  // The sentinel stays at the bar's resting place, so it leaving through the
  // top of the viewport means the bar has pinned.
  if (nav && sentinel) {
    const observer = new IntersectionObserver(([entry]) => {
      nav.classList.toggle('is-pinned', !entry.isIntersecting && entry.boundingClientRect.top < 0);
    });
    observer.observe(sentinel);
  }
</script>
